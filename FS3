#include <Arduino.h>

const byte PIN_LED_BLEU  = 6; // D6
const byte PIN_LED_VERT  = 7; // D7
const byte PIN_LED_ROUGE = 8; // D8

const float SEUIL_BRADYCARDIE = 60.0f;
const float SEUIL_TACHYCARDIE = 100.0f;
const float BPM_MIN_VALIDE = 35.0f;
const float BPM_MAX_VALIDE = 220.0f;

enum EtatSante { ETEINT, FAIBLE_JAUNE, NORMAL_VERT, ELEVE_ROUGE };
EtatSante etatCourant = ETEINT;

void actualiserEtatSante(float bpm, bool doigtPresent) {
  if (!doigtPresent || bpm < BPM_MIN_VALIDE || bpm > BPM_MAX_VALIDE) {
    etatCourant = ETEINT;
  } else if (bpm < SEUIL_BRADYCARDIE) {
    etatCourant = FAIBLE_JAUNE;
  } else if (bpm <= SEUIL_TACHYCARDIE) {
    etatCourant = NORMAL_VERT;
  } else {
    etatCourant = ELEVE_ROUGE;
  }
}

// Gestion de l'affichage avec équilibrage chromatique pour le jaune
void piloterLedRGB() {
  switch (etatCourant) {
    case ETEINT:
      digitalWrite(PIN_LED_ROUGE, LOW);
      digitalWrite(PIN_LED_VERT, LOW);
      digitalWrite(PIN_LED_BLEU, LOW);
      break;

    case NORMAL_VERT:
      digitalWrite(PIN_LED_ROUGE, LOW);
      digitalWrite(PIN_LED_VERT, HIGH);
      digitalWrite(PIN_LED_BLEU, LOW);
      break;

    case ELEVE_ROUGE:
      digitalWrite(PIN_LED_ROUGE, HIGH);
      digitalWrite(PIN_LED_VERT, LOW);
      digitalWrite(PIN_LED_BLEU, LOW);
      break;

    case FAIBLE_JAUNE:
      // Pour obtenir un vrai jaune ambré : rouge à 100 %, vert atténué
      digitalWrite(PIN_LED_BLEU, LOW);
      digitalWrite(PIN_LED_ROUGE, HIGH);
      
      // On hache le vert : allumé 1 cycle sur 4 (ratio ~25%)
      // Cela évite que le vert ne sature la couleur
      static byte compteur = 0;
      compteur = (compteur + 1) % 4;
      digitalWrite(PIN_LED_VERT, (compteur == 0) ? HIGH : LOW);
      break;
  }
}

void setup() {
  Serial.begin(115200);

  pinMode(PIN_LED_ROUGE, OUTPUT);
  pinMode(PIN_LED_VERT, OUTPUT);
  pinMode(PIN_LED_BLEU, OUTPUT);

  Serial.println(F("=== Test Unitaire FS3 Calibre ==="));
}

void loop() {
  // Lecture moniteur série sans blocage
  if (Serial.available() > 0) {
    float bpmTest = Serial.parseFloat();
    while (Serial.available() > 0) {
      Serial.read();
      delay(2);
    }

    bool doigt = (bpmTest > 0);
    actualiserEtatSante(bpmTest, doigt);

    Serial.print(F("BPM = "));
    Serial.print(bpmTest);
    Serial.print(F(" -> Etat : "));
    if (etatCourant == ETEINT) Serial.println(F("ETEINT"));
    if (etatCourant == FAIBLE_JAUNE) Serial.println(F("JAUNE (Faible)"));
    if (etatCourant == NORMAL_VERT) Serial.println(F("VERT (Normal)"));
    if (etatCourant == ELEVE_ROUGE) Serial.println(F("ROUGE (Eleve)"));
  }

  // Actualisation continue des broches
  piloterLedRGB();
  delayMicroseconds(500); // Découpage fluide pour le hachage
}

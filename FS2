#include <Arduino.h>
#include <U8g2lib.h>
#include <ThreeWire.h>
#include <RtcDS1302.h>

// --- Configuration DS1302 ---
const int RST_PIN = 2; // D2 (CE)
const int DAT_PIN = 3; // D3 (IO)
const int CLK_PIN = 4; // D4 (SCLK)

ThreeWire monFil(DAT_PIN, CLK_PIN, RST_PIN);
RtcDS1302<ThreeWire> Rtc(monFil);

// --- Configuration OLED 1 via Software I2C sur tes broches réelles ---
// U8G2_SSD1306_128X64_NONAME_1_SW_I2C(rotation, clock, data, reset)
// SCL sur A4, SDA sur A3
U8G2_SSD1306_128X64_NONAME_1_SW_I2C u8g2(U8G2_R0, /* clock=*/ A4, /* data=*/ A3, /* reset=*/ U8X8_PIN_NONE);

unsigned long dernierAffichage = 0;
const unsigned long PERIODE_AFFICHAGE_MS = 1000;

char tamponCmd[32];
byte indexCmd = 0;

void appliquerHeure(const char* str) {
  int h, m, s, jour, mois, annee;
  if (sscanf(str + 4, "%d:%d:%d %d/%d/%d", &h, &m, &s, &jour, &mois, &annee) == 6) {
    RtcDateTime dt(annee, mois, jour, h, m, s);
    Rtc.SetDateTime(dt);
    Serial.print(F("-> Heure mise a jour : "));
    Serial.println(str + 4);
  } else {
    Serial.println(F("Format incorrect. Exemple : SET 12:15:00 11/10/2026"));
  }
}

void setup() {
  Serial.begin(115200);

  // Initialisation RTC
  Rtc.Begin();
  if (Rtc.GetIsWriteProtected()) {
    Rtc.SetIsWriteProtected(false);
  }
  if (!Rtc.GetIsRunning()) {
    Rtc.SetIsRunning(true);
  }

  // Initialisation écran OLED
  u8g2.begin();

  Serial.println(F("=== FS2 Pret (U8g2 SW I2C sur A3/A4) ==="));
  Serial.println(F("Format reglage : SET HH:MM:SS JJ/MM/AAAA"));
}

void loop() {
  // Lecture de commande de réglage sur le port série
  while (Serial.available() > 0) {
    char c = (char)Serial.read();
    if (c == '\n' || c == '\r') {
      if (indexCmd > 0) {
        tamponCmd[indexCmd] = '\0';
        if (strncmp(tamponCmd, "SET ", 4) == 0) {
          appliquerHeure(tamponCmd);
        }
        indexCmd = 0;
      }
    } else {
      if (indexCmd < sizeof(tamponCmd) - 1) {
        tamponCmd[indexCmd++] = c;
      }
    }
  }

  // Rafraîchissement chaque seconde
  unsigned long maintenant = millis();
  if (maintenant - dernierAffichage >= PERIODE_AFFICHAGE_MS) {
    dernierAffichage = maintenant;

    RtcDateTime dt = Rtc.GetDateTime();

    char texteHeure[10];
    snprintf(texteHeure, sizeof(texteHeure), "%02d:%02d:%02d", dt.Hour(), dt.Minute(), dt.Second());

    char texteDate[12];
    snprintf(texteDate, sizeof(texteDate), "%02d/%02d/%04d", dt.Day(), dt.Month(), dt.Year());

    // Affichage U8g2 (mode page buffer pour économiser la RAM)
    u8g2.firstPage();
    do {
      u8g2.setFont(u8g2_font_logisoso16_tf);
      u8g2.drawStr(18, 28, texteHeure);

      u8g2.setFont(u8g2_font_6x12_tf);
      u8g2.drawStr(30, 52, texteDate);
    } while (u8g2.nextPage());

    // Log série
    Serial.print(texteHeure);
    Serial.print(F(" | "));
    Serial.println(texteDate);
  }
}

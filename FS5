#include <Arduino.h>
#include <U8g2lib.h>
#include <ThreeWire.h>
#include <RtcDS1302.h>

// --- RTC DS1302 (D2, D3, D4) ---
const int RST_PIN = 2; // CE
const int DAT_PIN = 3; // IO
const int CLK_PIN = 4; // SCLK

ThreeWire monFil(DAT_PIN, CLK_PIN, RST_PIN);
RtcDS1302<ThreeWire> Rtc(monFil);

// --- Écrans OLED (Software I2C) ---
U8G2_SSD1306_128X64_NONAME_1_SW_I2C ecran1(U8G2_R0, /* clock=*/ A4, /* data=*/ A3, /* reset=*/ U8X8_PIN_NONE);
U8G2_SSD1306_128X64_NONAME_1_SW_I2C ecran2(U8G2_R0, /* clock=*/ A2, /* data=*/ A1, /* reset=*/ U8X8_PIN_NONE);

// --- Encodeur EC11 ---
const byte PIN_ENC_A  = 10;
const byte PIN_ENC_B  = 12;
const byte PIN_ENC_SW = 11;

// --- Échelles d'oscilloscope (ET5.4) ---
const uint8_t NB_ECHELLES = 3;
const unsigned int ECHELLES_MS[NB_ECHELLES] = {10, 25, 50}; // 10ms, 25ms, 50ms par point
const char NOMS_ECHELLES[3][8] = {"10ms", "25ms", "50ms"};
volatile int8_t indexEchelle = 1; // 25ms par défaut

// --- Oscilloscope PPG ---
const byte LARGEUR_TRACE = 88;
const byte HAUTEUR_TRACE = 36;
const byte Y_BASE = 54;
uint8_t bufferPPG[LARGEUR_TRACE];
byte indexTrace = 0;

// Variables globales
char strHeure[9] = "14:30:00";
int bpmAffiche = 65;
bool doigtDetecte = true;

unsigned long dernierTempsEch = 0;
unsigned long dernierAffichagePPG = 0;
unsigned long dernierAffichageHeure = 0;
unsigned long dernierRtc = 0;

bool dernierEtatSW = HIGH;
unsigned long dernierDebounceSW = 0;

// Anti-rebond encodeur
volatile unsigned long dernierTempsInterruption = 0;

ISR(PCINT0_vect) {
  uint8_t etatA = (PINB & (1 << PINB2)) ? HIGH : LOW; // D10
  uint8_t etatB = (PINB & (1 << PINB4)) ? HIGH : LOW; // D12

  unsigned long maintenant = millis();
  if (etatA == LOW && (maintenant - dernierTempsInterruption > 40)) {
    dernierTempsInterruption = maintenant;
    if (etatB == HIGH) {
      if (indexEchelle < NB_ECHELLES - 1) indexEchelle++;
    } else {
      if (indexEchelle > 0) indexEchelle--;
    }
  }
}

// Onde PPG simulée (battement cardiaque standard ~65 BPM : période = 920 ms)
uint8_t calculerOndePhysiologique(unsigned long t_ms) {
  const unsigned long T_BATTEMENT = 920;
  unsigned long phase = t_ms % T_BATTEMENT;

  if (phase < 140) {
    // Montée systolique
    return (uint8_t)((phase * (HAUTEUR_TRACE - 2)) / 140);
  } else if (phase < 300) {
    // Descente vers incisure dicrote
    return (uint8_t)((HAUTEUR_TRACE - 2) - ((phase - 140) * ((HAUTEUR_TRACE - 2) - 10)) / 160);
  } else if (phase < 440) {
    // Onde dicrote (rebond)
    return (uint8_t)(10 + ((phase - 300) * 10) / 140);
  } else if (phase < 580) {
    // Descente finale vers zéro
    return (uint8_t)(20 - ((phase - 440) * 20) / 140);
  } else {
    // Diastole (ligne isoélectrique de base)
    return 0;
  }
}

void dessinerEcran1() {
  ecran1.firstPage();
  do {
    ecran1.setFont(u8g2_font_helvB14_tf);
    ecran1.drawStr(22, 22, strHeure);

    ecran1.drawHLine(14, 30, 100);

    ecran1.setFont(u8g2_font_6x10_tf);
    ecran1.drawStr(20, 50, "POULS :");

    ecran1.setFont(u8g2_font_helvB14_tf);
    if (doigtDetecte && bpmAffiche >= 35 && bpmAffiche <= 220) {
      char strBpm[5];
      itoa(bpmAffiche, strBpm, 10);
      ecran1.drawStr(70, 51, strBpm);
      ecran1.setFont(u8g2_font_6x10_tf);
      ecran1.drawStr(100, 50, "bpm");
    } else {
      ecran1.drawStr(74, 51, "--");
    }
  } while (ecran1.nextPage());
}

void dessinerEcran2() {
  ecran2.firstPage();
  do {
    // En-tête
    ecran2.setFont(u8g2_font_6x10_tf);
    ecran2.drawStr(4, 10, "PPG");
    ecran2.drawStr(78, 10, NOMS_ECHELLES[indexEchelle]);

    // Axes
    ecran2.drawVLine(18, 16, 39);
    ecran2.drawHLine(18, Y_BASE, LARGEUR_TRACE);

    // Graduations Y (0.0, 0.5, 1.0)
    ecran2.drawHLine(15, Y_BASE, 3);
    ecran2.drawHLine(15, Y_BASE - HAUTEUR_TRACE / 2, 3);
    ecran2.drawHLine(15, Y_BASE - HAUTEUR_TRACE, 3);

    ecran2.setFont(u8g2_font_5x7_tf);
    ecran2.drawStr(6, Y_BASE + 2, "0");
    ecran2.drawStr(6, Y_BASE - HAUTEUR_TRACE + 6, "1");

    // Repères horizontaux
    ecran2.drawVLine(18 + 29, Y_BASE, 3);
    ecran2.drawVLine(18 + 58, Y_BASE, 3);
    ecran2.drawVLine(18 + 87, Y_BASE, 3);

    // Tracé de l'onde
    for (byte i = 0; i < LARGEUR_TRACE - 1; i++) {
      byte idx1 = (indexTrace + i) % LARGEUR_TRACE;
      byte idx2 = (indexTrace + i + 1) % LARGEUR_TRACE;

      byte y1 = Y_BASE - bufferPPG[idx1];
      byte y2 = Y_BASE - bufferPPG[idx2];

      ecran2.drawLine(18 + i, y1, 18 + i + 1, y2);
    }
  } while (ecran2.nextPage());
}

void setup() {
  Serial.begin(115200);

  pinMode(PIN_ENC_A, INPUT_PULLUP);
  pinMode(PIN_ENC_B, INPUT_PULLUP);
  pinMode(PIN_ENC_SW, INPUT_PULLUP);

  cli();
  PCICR |= (1 << PCIE0);
  PCMSK0 |= (1 << PCINT2) | (1 << PCINT4);
  sei();

  Rtc.Begin();
  if (Rtc.GetIsWriteProtected()) Rtc.SetIsWriteProtected(false);
  if (!Rtc.GetIsRunning()) Rtc.SetIsRunning(true);

  ecran1.begin();
  ecran2.begin();

  for (byte i = 0; i < LARGEUR_TRACE; i++) {
    bufferPPG[i] = 0;
  }
}

void loop() {
  unsigned long maintenant = millis();

  // 1. Bouton encodeur (bascule rapide)
  bool lectureSW = digitalRead(PIN_ENC_SW);
  if (lectureSW != dernierEtatSW && (maintenant - dernierDebounceSW > 60)) {
    if (lectureSW == LOW) {
      indexEchelle = (indexEchelle + 1) % NB_ECHELLES;
    }
    dernierDebounceSW = maintenant;
  }
  dernierEtatSW = lectureSW;

  // 2. Acquisition temporelle continue (rattrapage sans perte de points)
  unsigned int dt = ECHELLES_MS[indexEchelle];
  while (maintenant - dernierTempsEch >= dt) {
    dernierTempsEch += dt;
    bufferPPG[indexTrace] = calculerOndePhysiologique(dernierTempsEch);
    indexTrace = (indexTrace + 1) % LARGEUR_TRACE;
  }

  // 3. Rafraîchissement RTC chaque seconde
  if (maintenant - dernierRtc >= 1000) {
    dernierRtc = maintenant;
    RtcDateTime dtRTC = Rtc.GetDateTime();
    snprintf(strHeure, sizeof(strHeure), "%02d:%02d:%02d", dtRTC.Hour(), dtRTC.Minute(), dtRTC.Second());
    dessinerEcran1(); // Rafraîchissement de l'heure uniquement à la seconde
  }

  // 4. Rafraîchissement régulier de l'écran PPG (~15 FPS)
  if (maintenant - dernierAffichagePPG >= 65) {
    dernierAffichagePPG = maintenant;
    dessinerEcran2();
  }
}

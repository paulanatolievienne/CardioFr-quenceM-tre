#include <Arduino.h>

// --- Configuration matérielle ---
const byte PIN_PPG = A0;
const unsigned long PERIODE_ECH_MS = 10; // 100 Hz

// --- Paramètres de filtrage ---
const float ALPHA_LISSE = 0.10f;  // Filtrage passe-bas légèrement renforcé
const float ALPHA_BASE  = 0.002f; // Ligne de base lente
const float ALPHA_DECAY = 0.998f; // Maintien d'enveloppe plus stable

// --- Variables de filtrage ---
float signalLisse = 0.0f;
float ligneBase   = 0.0f;
float creteMax    = 15.0f;
bool initialise   = false;
unsigned long derniereLecture = 0;

// --- Détection par Hystérésis & Période réfractaire ---
const float SEUIL_HAUT = 0.60f; // Déclenchement franc
const float SEUIL_BAS  = 0.30f; // Réarmement
const unsigned long TEMPS_REFRACTAIRE_MS = 450; // Bloque l'onde dicrote (max 133 BPM)

bool enPic = false;
unsigned long tempsDernierBattement = 0;

// --- Calcul et stabilisation du BPM ---
const byte TAILLE_BUFF = 5;
float buffBpm[TAILLE_BUFF] = {0};
byte indexBuff = 0;
float bpmFinal = 0.0f;

void setup() {
  Serial.begin(115200);
}

void loop() {
  unsigned long maintenant = millis();

  if (maintenant - derniereLecture < PERIODE_ECH_MS) {
    return;
  }
  derniereLecture = maintenant;

  int brut = analogRead(PIN_PPG);

  if (!initialise) {
    signalLisse = brut;
    ligneBase   = brut;
    initialise  = true;
  }

  // 1. Filtrage passe-bas et ligne de base
  signalLisse += ALPHA_LISSE * (brut - signalLisse);
  ligneBase   += ALPHA_BASE * (signalLisse - ligneBase);
  float ac = signalLisse - ligneBase;

  // 2. Détection présence du doigt (plage ADC typique WPSE340)
  bool doigtPresent = (brut > 100 && brut < 950);

  // 3. Suivi d'enveloppe crête
  if (ac > creteMax) {
    creteMax = ac;
  } else {
    creteMax *= ALPHA_DECAY;
    if (creteMax < 12.0f) creteMax = 12.0f;
  }

  // 4. Normalisation
  float norm = 0.0f;
  if (ac > 0.0f) {
    norm = ac / creteMax;
    if (norm > 1.0f) norm = 1.0f;
  }

  // 5. Machine à états
  bool battementDetecte = false;

  if (!enPic) {
    if (norm > SEUIL_HAUT && (maintenant - tempsDernierBattement > TEMPS_REFRACTAIRE_MS) && doigtPresent) {
      enPic = true;
      battementDetecte = true;

      unsigned long deltaT = maintenant - tempsDernierBattement;
      tempsDernierBattement = maintenant;

      // Intervalle physiologique valide (450 ms à 1600 ms -> ~37 à 133 BPM)
      if (deltaT >= TEMPS_REFRACTAIRE_MS && deltaT <= 1600) {
        float bpmInst = 60000.0f / (float)deltaT;

        // Rejet des sauts brutaux si on a déjà une estimation stable
        bool valide = true;
        if (bpmFinal > 40.0f) {
          float ecart = abs(bpmInst - bpmFinal);
          if (ecart > (bpmFinal * 0.30f)) { 
            valide = false; // Variation > 30% rejetée (parasite)
          }
        }

        if (valide) {
          buffBpm[indexBuff] = bpmInst;
          indexBuff = (indexBuff + 1) % TAILLE_BUFF;

          float somme = 0;
          byte compte = 0;
          for (byte i = 0; i < TAILLE_BUFF; i++) {
            if (buffBpm[i] > 0) {
              somme += buffBpm[i];
              compte++;
            }
          }
          if (compte > 0) {
            bpmFinal = somme / compte;
          }
        }
      }
    }
  } else {
    if (norm < SEUIL_BAS) {
      enPic = false; // Réarmé
    }
  }

  if (!doigtPresent) {
    bpmFinal = 0.0f;
  }

  // --- Télémétrie Teleplot ---
  Serial.print(">Norm:");
  Serial.println(norm, 2);

  Serial.print(">BPM:");
  Serial.println(bpmFinal, 1);

  Serial.print(">Pulse:");
  Serial.println(battementDetecte ? 1 : 0);
}

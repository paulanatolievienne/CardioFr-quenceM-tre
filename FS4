#include <Arduino.h>

// --- Broches réelles ---
const byte PIN_BUZZER = 5; // D5
const byte PIN_BOUTON = 9; // D9 (câblé vers GND)

// --- Fréquences sonores adaptées aux personnes malvoyantes (ET4.2) ---
const unsigned int FREQ_GRAVE   = 440;  // Rythme faible (<60 BPM)
const unsigned int FREQ_MODEREE = 880;  // Rythme normal (60-100 BPM)
const unsigned int FREQ_AIGUE   = 1760; // Rythme élevé (>100 BPM)

// Seuils cardiologiques (cohérence avec FS3)
const float SEUIL_BRADYCARDIE = 60.0f;
const float SEUIL_TACHYCARDIE = 100.0f;
const float BPM_MIN_VALIDE    = 35.0f;
const float BPM_MAX_VALIDE    = 220.0f;

// --- Gestion temporelle non-bloquante du son ---
const unsigned long DUREE_BIP_MS = 40; // Impulsion sonore brève de 40 ms
unsigned long debutBip = 0;
bool sonEnCours = false;

// --- Gestion de l'interruption / Mute (ET4.3) ---
bool sonActive = true;
bool dernierEtatBouton = HIGH;
unsigned long dernierAntiRebond = 0;
const unsigned long DELAI_ANTI_REBOND_MS = 50;

// Variables pour le test de simulation
float bpmActuel = 75.0f;
bool contactPresent = true;
unsigned long dernierBattementSimule = 0;

// Déclenchement d'un bip synchronisé (ET4.1 et ET4.2)
void declencherBip(float bpm, bool contact) {
  if (!sonActive || !contact || bpm < BPM_MIN_VALIDE || bpm > BPM_MAX_VALIDE) {
    return;
  }

  unsigned int freq = FREQ_MODEREE;
  if (bpm < SEUIL_BRADYCARDIE) {
    freq = FREQ_GRAVE;
  } else if (bpm > SEUIL_TACHYCARDIE) {
    freq = FREQ_AIGUE;
  }

  tone(PIN_BUZZER, freq);
  debutBip = millis();
  sonEnCours = true;
}

// Coupure automatique sans delay()
void gererFinBip() {
  if (sonEnCours && (millis() - debutBip >= DUREE_BIP_MS)) {
    noTone(PIN_BUZZER);
    sonEnCours = false;
  }
}

// Surveillance du bouton poussoir avec anti-rebond (ET4.3)
void verifierBoutonInterruption() {
  bool lecture = digitalRead(PIN_BOUTON);
  unsigned long maintenant = millis();

  if (lecture != dernierEtatBouton) {
    if (maintenant - dernierAntiRebond > DELAI_ANTI_REBOND_MS) {
      if (lecture == LOW) { // Front descendant : pression sur le bouton
        sonActive = !sonActive;
        if (!sonActive) {
          noTone(PIN_BUZZER); // Coupure instantanée si un son était émis
          sonEnCours = false;
        }
        Serial.print(F("-> Bouton presse : Son "));
        Serial.println(sonActive ? F("ACTIVE (ON)") : F("COUPE (MUTE)"));
      }
      dernierAntiRebond = maintenant;
    }
  }
  dernierEtatBouton = lecture;
}

void setup() {
  Serial.begin(115200);

  pinMode(PIN_BUZZER, OUTPUT);
  pinMode(PIN_BOUTON, INPUT_PULLUP);

  Serial.println(F("=== Test Unitaire FS4 : Buzzer (D5) & Bouton (D9) ==="));
  Serial.println(F("Commandes console : saisis 50, 75, 120 ou 0"));
  Serial.println(F("Appuie sur le bouton pour basculer Mute / Unmute."));
}

void loop() {
  unsigned long maintenant = millis();

  // 1. Écoute du bouton avec latence minimale (ET4.3)
  verifierBoutonInterruption();

  // 2. Gestion de l'extinction du bip
  gererFinBip();

  // 3. Réception de valeurs de test via le moniteur série
  if (Serial.available() > 0) {
    float val = Serial.parseFloat();
    while (Serial.available() > 0) {
      Serial.read();
      delay(2);
    }

    bpmActuel = val;
    contactPresent = (val > 0);

    Serial.print(F("Reglage BPM teste : "));
    Serial.println(bpmActuel);
  }

  // 4. Génération périodique des bips au tempo cardiaque (ET4.1)
  if (contactPresent && bpmActuel >= BPM_MIN_VALIDE && bpmActuel <= BPM_MAX_VALIDE) {
    unsigned long periodeBattement = (unsigned long)(60000.0f / bpmActuel);
    if (maintenant - dernierBattementSimule >= periodeBattement) {
      dernierBattementSimule = maintenant;
      declencherBip(bpmActuel, contactPresent);
      Serial.println(F("* Bip ! *"));
    }
  }
}

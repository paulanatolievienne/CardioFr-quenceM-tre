#include <Arduino.h>
#include <HeartRateProcessor.h>

const int pulsePin = A2;

HeartRateProcessor heartProcessor;

void setup() {
  Serial.begin(115200);
  pinMode(pulsePin, INPUT);
}

void loop() {
  unsigned long now = millis();

  static unsigned long lastSample = 0;
  if (now - lastSample >= 20) {
    lastSample = now;

    int rawSignal = analogRead(pulsePin);
    heartProcessor.processSample(rawSignal, now);

    Serial.print(F(">signal:"));
    Serial.println(rawSignal);
    Serial.print(F(">seuil:"));
    Serial.println(heartProcessor.threshold);
    Serial.print(F(">battement:"));
    Serial.println(heartProcessor.pulseDetected ? 600 : 450);
    Serial.print(F(">bpm:"));
    Serial.println(heartProcessor.bpm);
  }
}

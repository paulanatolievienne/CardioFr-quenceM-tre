#include <Arduino.h>
#include <EEPROM.h>
#include <U8g2lib.h>
#include <ThreeWire.h>
#include <RtcDS1302.h>

// =============================================================================
// 1. CONFIGURATION MATÉRIELLE
// =============================================================================
const byte PIN_PPG = A0;

// RTC DS1302 (D2, D3, D4)
const int RST_PIN = 2;
const int DAT_PIN = 3;
const int CLK_PIN = 4;
ThreeWire monFil(DAT_PIN, CLK_PIN, RST_PIN);
RtcDS1302<ThreeWire> Rtc(monFil);

// LED RGB
const byte PIN_LED_BLEU  = 6;
const byte PIN_LED_VERT  = 7;
const byte PIN_LED_ROUGE = 8;

// Buzzer & Bouton Mute
const byte PIN_BUZZER      = 5;
const byte PIN_BOUTON_MUTE = 9;

// Encodeur EC11
const byte PIN_ENC_A  = 10;
const byte PIN_ENC_B  = 12;
const byte PIN_ENC_SW = 11;

// Écrans OLED (Software I2C)
U8G2_SSD1306_128X64_NONAME_1_SW_I2C ecran1(U8G2_R0, /* clock=*/ A4, /* data=*/ A3, /* reset=*/ U8X8_PIN_NONE);
U8G2_SSD1306_128X64_NONAME_1_SW_I2C ecran2(U8G2_R0, /* clock=*/ A2, /* data=*/ A1, /* reset=*/ U8X8_PIN_NONE);

// =============================================================================
// 2. STRUCTURE EEPROM (FS6)
// =============================================================================
#define ADRESSE_MAGIC       0    
#define ADRESSE_NB_MESURES  2    
#define ADRESSE_LANGUE      3    
#define ADRESSE_DEBUT_DATA  4    
#define MAX_MESURES         10
const uint16_t EEPROM_MAGIC = 0xCAFE;

struct MesureEEPROM {
  uint8_t bpm;
  uint8_t jour;
  uint8_t mois;
  uint8_t annee;
  uint8_t heure;
  uint8_t minute;
  uint8_t seconde;
};

enum Langue { FR = 0, EN = 1 };
Langue langueActive = FR;

enum ModeEcran { MODE_NORMAL, MODE_HISTORIQUE, MODE_OPTIONS };
ModeEcran modeActuel = MODE_NORMAL;

int indexHistorique = 0;
uint8_t nbMesuresStockees = 0;
byte optionSelectionnee = 0;

bool acquisitionEnCours = false;
uint8_t compteurEchantillons = 0;
uint16_t sommeBpm = 0;
unsigned long dernierEchantillonMoyenne = 0;

const unsigned long SEUIL_APPUI_COURT_MS = 1500;
const unsigned long SEUIL_APPUI_LONG_MS  = 5000;
bool boutonEstEnfonce = false;
unsigned long tempsDebutEnfonce = 0;
unsigned long dureeAppuiCourante = 0;

// =============================================================================
// 3. VARIABLES TRAITEMENT PPG (GÉRÉES EN INTERRUPTION TIMER1)
// =============================================================================
volatile int ppgBrut = 0;
volatile float ppgLisse = 500.0f;
volatile float ppgBase = 500.0f;
volatile float ppgAC = 0.0f;
volatile float ppgCrete = 30.0f;
volatile uint8_t ppgNormHauteur = 0; // 0 à 34 pixels pour l'écran

volatile bool doigtPresentVolatile = false;
volatile int bpmCalculeVolatile = 0;
volatile bool nouveauBattement = false;

// Variables miroir pour la boucle loop
int bpmAffiche = 0;
bool doigtPresent = false;

// Oscilloscope PPG (Écran 2)
const byte LARGEUR_TRACE = 88;
const byte HAUTEUR_TRACE = 36;
const byte Y_BASE = 54;
uint8_t bufferPPG[LARGEUR_TRACE];
byte indexTrace = 0;

const uint8_t NB_ECHELLES = 3;
const unsigned int ECHELLES_DIVISEUR[NB_ECHELLES] = {1, 2, 4}; // Décimation temporelle
const char NOMS_ECHELLES[3][8] = {"10ms", "20ms", "40ms"};
volatile int8_t indexEchelle = 1;

unsigned long dernierAffichagePPG = 0;
unsigned long dernierAffichageHeure = 0;
char strHeure[9] = "00:00:00";

// Actionneurs
const unsigned int FREQ_GRAVE   = 440;
const unsigned int FREQ_MODEREE = 880;
const unsigned int FREQ_AIGUE   = 1760;
bool sonActive = true;
bool dernierEtatMute = HIGH;
unsigned long dernierDebounceMute = 0;

volatile int deltaEncodeur = 0;
volatile unsigned long dernierTempsInterruption = 0;

// Interruption Encodeur
ISR(PCINT0_vect) {
  uint8_t etatA = (PINB & (1 << PINB2)) ? HIGH : LOW;
  uint8_t etatB = (PINB & (1 << PINB4)) ? HIGH : LOW;

  unsigned long maintenant = millis();
  if (etatA == LOW && (maintenant - dernierTempsInterruption > 35)) {
    dernierTempsInterruption = maintenant;
    if (etatB == HIGH) {
      deltaEncodeur++;
      if (modeActuel == MODE_NORMAL && indexEchelle < NB_ECHELLES - 1) indexEchelle++;
    } else {
      deltaEncodeur--;
      if (modeActuel == MODE_NORMAL && indexEchelle > 0) indexEchelle--;
    }
  }
}

// =============================================================================
// ROUTINE D'INTERRUPTION TIMER 1 : CADENCÉE STRICTEMENT À 100 Hz (10 ms)
// =============================================================================
ISR(TIMER1_COMPA_vect) {
  static unsigned int compteurEchelle = 0;
  static unsigned long tempsDernierPic = 0;
  static bool enPicInterne = false;
  static unsigned long tempsMsInterne = 0;
  tempsMsInterne += 10;

  int brut = analogRead(PIN_PPG);
  ppgBrut = brut;

  // Détection physique nette du doigt posé
  if (brut < 180 || brut > 980) {
    doigtPresentVolatile = false;
    bpmCalculeVolatile = 0;
    ppgNormHauteur = 0;
    enPicInterne = false;
    ppgLisse = brut;
    ppgBase = brut;
    return;
  }

  doigtPresentVolatile = true;

  // Filtrage passe-bas et extraction continue (DC)
  ppgLisse += 0.20f * (brut - ppgLisse);
  ppgBase  += 0.02f * (ppgLisse - ppgBase);
  float ac = ppgLisse - ppgBase;
  ppgAC = ac;

  // Suivi de l'enveloppe crête
  if (abs(ac) > ppgCrete) {
    ppgCrete = abs(ac);
  } else {
    ppgCrete *= 0.992f;
    if (ppgCrete < 15.0f) ppgCrete = 15.0f;
  }

  // Normalisation symétrique centrée de 0 à 34 pixels
  float n = 0.5f + (ac / (2.0f * ppgCrete));
  if (n > 1.0f) n = 1.0f;
  if (n < 0.0f) n = 0.0f;
  ppgNormHauteur = (uint8_t)(n * 34.0f);

  // Trigger de Schmitt pour détection des battements
  if (!enPicInterne) {
    if (n > 0.60f && (tempsMsInterne - tempsDernierPic > 360)) {
      enPicInterne = true;
      unsigned long dt = tempsMsInterne - tempsDernierPic;
      tempsDernierPic = tempsMsInterne;

      if (dt >= 360 && dt <= 1600) {
        int bpmInst = 60000UL / dt;
        if (bpmCalculeVolatile == 0) bpmCalculeVolatile = bpmInst;
        else bpmCalculeVolatile = (bpmCalculeVolatile * 3 + bpmInst) / 4;
        nouveauBattement = true;
      }
    }
  } else {
    if (n < 0.35f) {
      enPicInterne = false; // Réarmé
    }
  }

  // Enregistrement dans le buffer de l'oscilloscope selon l'échelle
  compteurEchelle++;
  if (compteurEchelle >= ECHELLES_DIVISEUR[indexEchelle]) {
    compteurEchelle = 0;
    bufferPPG[indexTrace] = ppgNormHauteur;
    indexTrace = (indexTrace + 1) % LARGEUR_TRACE;
  }
}

// =============================================================================
// 4. GESTION EEPROM
// =============================================================================
void initialiserEEPROM() {
  uint16_t magic;
  EEPROM.get(ADRESSE_MAGIC, magic);
  if (magic != EEPROM_MAGIC) {
    EEPROM.put(ADRESSE_MAGIC, EEPROM_MAGIC);
    nbMesuresStockees = 0;
    EEPROM.write(ADRESSE_NB_MESURES, 0);
    langueActive = FR;
    EEPROM.write(ADRESSE_LANGUE, (uint8_t)FR);
  } else {
    nbMesuresStockees = EEPROM.read(ADRESSE_NB_MESURES);
    if (nbMesuresStockees > MAX_MESURES) nbMesuresStockees = 0;
    langueActive = (Langue)EEPROM.read(ADRESSE_LANGUE);
    if (langueActive > EN) langueActive = FR;
  }
}

void effacerHistoriqueEEPROM() {
  nbMesuresStockees = 0;
  EEPROM.write(ADRESSE_NB_MESURES, 0);
  indexHistorique = 0;
}

void sauvegarderMesure(uint8_t bpmMoyen, RtcDateTime dt) {
  MesureEEPROM m;
  m.bpm = bpmMoyen;
  m.jour = dt.Day();
  m.mois = dt.Month();
  m.annee = (uint8_t)(dt.Year() - 2000);
  m.heure = dt.Hour();
  m.minute = dt.Minute();
  m.seconde = dt.Second();

  if (nbMesuresStockees >= MAX_MESURES) {
    for (int i = 0; i < MAX_MESURES - 1; i++) {
      MesureEEPROM temp;
      EEPROM.get(ADRESSE_DEBUT_DATA + (i + 1) * sizeof(MesureEEPROM), temp);
      EEPROM.put(ADRESSE_DEBUT_DATA + i * sizeof(MesureEEPROM), temp);
    }
    nbMesuresStockees = MAX_MESURES - 1;
  }

  int adresse = ADRESSE_DEBUT_DATA + nbMesuresStockees * sizeof(MesureEEPROM);
  EEPROM.put(adresse, m);
  nbMesuresStockees++;
  EEPROM.write(ADRESSE_NB_MESURES, nbMesuresStockees);
}

MesureEEPROM lireMesure(uint8_t index) {
  MesureEEPROM m;
  int adresse = ADRESSE_DEBUT_DATA + index * sizeof(MesureEEPROM);
  EEPROM.get(adresse, m);
  return m;
}

// =============================================================================
// 5. ACTIONNEURS
// =============================================================================
void actualiserActionneurs() {
  if (!doigtPresent || bpmAffiche < 35 || bpmAffiche > 220) {
    digitalWrite(PIN_LED_ROUGE, LOW);
    digitalWrite(PIN_LED_VERT, LOW);
    digitalWrite(PIN_LED_BLEU, LOW);
    return;
  }

  if (bpmAffiche < 60) {
    digitalWrite(PIN_LED_BLEU, LOW);
    digitalWrite(PIN_LED_ROUGE, HIGH);
    static byte cpt = 0;
    cpt = (cpt + 1) % 4;
    digitalWrite(PIN_LED_VERT, (cpt == 0) ? HIGH : LOW);
  } else if (bpmAffiche <= 100) {
    digitalWrite(PIN_LED_ROUGE, LOW);
    digitalWrite(PIN_LED_VERT, HIGH);
    digitalWrite(PIN_LED_BLEU, LOW);
  } else {
    digitalWrite(PIN_LED_ROUGE, HIGH);
    digitalWrite(PIN_LED_VERT, LOW);
    digitalWrite(PIN_LED_BLEU, LOW);
  }
}

void declencherBip() {
  if (!sonActive || !doigtPresent || bpmAffiche < 35 || bpmAffiche > 220) return;

  unsigned int freq = FREQ_MODEREE;
  if (bpmAffiche < 60) freq = FREQ_GRAVE;
  else if (bpmAffiche > 100) freq = FREQ_AIGUE;

  tone(PIN_BUZZER, freq, 35);
}

// =============================================================================
// 6. DESSIN DES ÉCRANS
// =============================================================================
void dessinerEcran1() {
  ecran1.firstPage();
  do {
    if (boutonEstEnfonce) {
      ecran1.setFont(u8g2_font_6x10_tf);
      ecran1.drawStr(14, 18, (langueActive == FR) ? "APPUI EN COURS..." : "HOLDING...");

      char strSec[15];
      snprintf(strSec, sizeof(strSec), "%lu s / 5s", dureeAppuiCourante / 1000);
      ecran1.drawStr(36, 34, strSec);

      ecran1.drawFrame(14, 42, 100, 8);
      int largeur = map(constrain(dureeAppuiCourante, 0, SEUIL_APPUI_LONG_MS), 0, SEUIL_APPUI_LONG_MS, 0, 100);
      ecran1.drawBox(14, 42, largeur, 8);

      ecran1.setFont(u8g2_font_4x6_tf);
      if (dureeAppuiCourante >= SEUIL_APPUI_LONG_MS) {
        ecran1.drawStr(18, 58, (langueActive == FR) ? "RELACHER POUR SAUVER" : "RELEASE TO SAVE");
      } else if (dureeAppuiCourante >= SEUIL_APPUI_COURT_MS) {
        ecran1.drawStr(22, 58, (langueActive == FR) ? "Relacher pour Menu" : "Release for Menu");
      }
      continue;
    }

    if (modeActuel == MODE_NORMAL) {
      ecran1.setFont(u8g2_font_helvB14_tf);
      ecran1.drawStr(22, 22, strHeure);
      ecran1.drawHLine(14, 28, 100);

      ecran1.setFont(u8g2_font_6x10_tf);
      if (acquisitionEnCours) {
        ecran1.drawStr(10, 42, (langueActive == FR) ? "ENREGISTREMENT..." : "RECORDING...");
        ecran1.drawFrame(14, 48, 100, 8);
        ecran1.drawBox(14, 48, compteurEchantillons * 10, 8);
      } else {
        ecran1.drawStr(16, 48, (langueActive == FR) ? "POULS :" : "PULSE :");
        ecran1.setFont(u8g2_font_helvB14_tf);
        if (doigtPresent && bpmAffiche >= 35 && bpmAffiche <= 220) {
          char strBpm[6];
          itoa(bpmAffiche, strBpm, 10);
          ecran1.drawStr(66, 49, strBpm);
          ecran1.setFont(u8g2_font_6x10_tf);
          ecran1.drawStr(100, 48, "bpm");
        } else {
          ecran1.drawStr(70, 49, "--");
          ecran1.setFont(u8g2_font_6x10_tf);
          ecran1.drawStr(98, 48, "bpm");
        }
        ecran1.setFont(u8g2_font_4x6_tf);
        ecran1.drawStr(12, 60, (langueActive == FR) ? "2s=Menu  5s=Sauver" : "2s=Menu  5s=Save");
      }
    } 
    else if (modeActuel == MODE_HISTORIQUE) {
      ecran1.setFont(u8g2_font_6x10_tf);
      ecran1.drawStr(4, 10, (langueActive == FR) ? "HISTORIQUE" : "HISTORY");

      char bufInd[10];
      snprintf(bufInd, sizeof(bufInd), "%d/%d", (nbMesuresStockees > 0) ? (indexHistorique + 1) : 0, nbMesuresStockees);
      ecran1.drawStr(92, 10, bufInd);
      ecran1.drawHLine(4, 13, 120);

      if (nbMesuresStockees == 0) {
        ecran1.drawStr(20, 36, (langueActive == FR) ? "Aucune mesure" : "No records");
      } else {
        MesureEEPROM m = lireMesure(indexHistorique);

        ecran1.setFont(u8g2_font_helvB14_tf);
        char bufBpm[12];
        snprintf(bufBpm, sizeof(bufBpm), "%d bpm", m.bpm);
        ecran1.drawStr(10, 34, bufBpm);

        ecran1.setFont(u8g2_font_5x7_tf);
        char bufDH[22];
        snprintf(bufDH, sizeof(bufDH), "%02d/%02d/20%02d %02d:%02d", m.jour, m.mois, m.annee, m.heure, m.minute);
        ecran1.drawStr(10, 48, bufDH);
      }

      ecran1.setFont(u8g2_font_4x6_tf);
      ecran1.drawStr(4, 60, (langueActive == FR) ? "Rot=Defiler  2s=Options" : "Rot=Scroll  2s=Options");
    }
    else if (modeActuel == MODE_OPTIONS) {
      ecran1.setFont(u8g2_font_6x10_tf);
      ecran1.drawStr(4, 10, "OPTIONS");
      ecran1.drawHLine(4, 13, 120);

      if (optionSelectionnee == 0) ecran1.drawStr(2, 28, ">");
      else ecran1.drawStr(2, 42, ">");

      ecran1.drawStr(12, 28, (langueActive == FR) ? "Langue : [FR]" : "Language : [EN]");
      ecran1.drawStr(12, 42, (langueActive == FR) ? "Effacer historique" : "Clear memory");

      ecran1.setFont(u8g2_font_4x6_tf);
      ecran1.drawStr(4, 58, (langueActive == FR) ? "Rot=Choix  5s=Valider  2s=Retour" : "Rot=Pick  5s=Select  2s=Back");
    }
  } while (ecran1.nextPage());
}

void dessinerEcran2() {
  ecran2.firstPage();
  do {
    ecran2.setFont(u8g2_font_6x10_tf);
    ecran2.drawStr(4, 10, "PPG");
    ecran2.drawStr(78, 10, NOMS_ECHELLES[indexEchelle]);

    // Axes
    ecran2.drawVLine(18, 16, 39);
    ecran2.drawHLine(18, Y_BASE, LARGEUR_TRACE);

    // Graduations Y
    ecran2.drawHLine(15, Y_BASE, 3);
    ecran2.drawHLine(15, Y_BASE - HAUTEUR_TRACE / 2, 3);
    ecran2.drawHLine(15, Y_BASE - HAUTEUR_TRACE, 3);

    ecran2.setFont(u8g2_font_5x7_tf);
    ecran2.drawStr(6, Y_BASE + 2, "0");
    ecran2.drawStr(6, Y_BASE - HAUTEUR_TRACE + 6, "1");

    // Repères horizontaux X
    ecran2.drawVLine(18 + 29, Y_BASE, 3);
    ecran2.drawVLine(18 + 58, Y_BASE, 3);
    ecran2.drawVLine(18 + 87, Y_BASE, 3);

    // Tracé de la courbe
    for (byte i = 0; i < LARGEUR_TRACE - 1; i++) {
      byte idx1 = (indexTrace + i) % LARGEUR_TRACE;
      byte idx2 = (indexTrace + i + 1) % LARGEUR_TRACE;

      byte y1 = Y_BASE - bufferPPG[idx1];
      byte y2 = Y_BASE - bufferPPG[idx2];

      ecran2.drawLine(18 + i, y1, 18 + i + 1, y2);
    }
  } while (ecran2.nextPage());
}

// =============================================================================
// 7. SETUP
// =============================================================================
void setup() {
  Serial.begin(115200);

  pinMode(PIN_PPG, INPUT);

  pinMode(PIN_LED_ROUGE, OUTPUT);
  pinMode(PIN_LED_VERT, OUTPUT);
  pinMode(PIN_LED_BLEU, OUTPUT);

  pinMode(PIN_BUZZER, OUTPUT);
  pinMode(PIN_BOUTON_MUTE, INPUT_PULLUP);

  pinMode(PIN_ENC_A, INPUT_PULLUP);
  pinMode(PIN_ENC_B, INPUT_PULLUP);
  pinMode(PIN_ENC_SW, INPUT_PULLUP);

  // Initialisation RTC
  Rtc.Begin();
  if (Rtc.GetIsWriteProtected()) Rtc.SetIsWriteProtected(false);
  if (!Rtc.GetIsRunning()) Rtc.SetIsRunning(true);

  // Initialisation Écrans
  ecran1.begin();
  ecran2.begin();

  initialiserEEPROM();

  for (byte i = 0; i < LARGEUR_TRACE; i++) bufferPPG[i] = 0;

  // Interruption PCINT Encodeur
  cli();
  PCICR |= (1 << PCIE0);
  PCMSK0 |= (1 << PCINT2) | (1 << PCINT4);

  // --- CONFIGURATION DU TIMER 1 À 100 Hz (10 ms) ---
  TCCR1A = 0;
  TCCR1B = 0;
  TCNT1  = 0;
  OCR1A = 2499;             // (16 000 000 / (64 * 100)) - 1 = 2499 -> 100 Hz exact
  TCCR1B |= (1 << WGM12);   // Mode CTC
  TCCR1B |= (1 << CS11) | (1 << CS10); // Prescaler 64
  TIMSK1 |= (1 << OCIE1A);  // Active interruption Compare Match A
  sei();

  Serial.println(F("=== SYSTEME AVEC TIMER1 PRET ==="));
}

// =============================================================================
// 8. LOOP
// =============================================================================
void loop() {
  unsigned long maintenant = millis();

  // Récupération atomique des variables calculées par le Timer1
  cli();
  doigtPresent = doigtPresentVolatile;
  bpmAffiche = bpmCalculeVolatile;
  bool sonBip = nouveauBattement;
  nouveauBattement = false;
  sei();

  // Bip au battement
  if (sonBip) {
    declencherBip();
  }

  // Actualisation LED
  actualiserActionneurs();

  // Bouton Mute FS4 (D9)
  bool lectureMute = digitalRead(PIN_BOUTON_MUTE);
  if (lectureMute != dernierEtatMute && (maintenant - dernierDebounceMute > 50)) {
    if (lectureMute == LOW) {
      sonActive = !sonActive;
      if (!sonActive) noTone(PIN_BUZZER);
    }
    dernierDebounceMute = maintenant;
  }
  dernierEtatMute = lectureMute;

  // Encodeur et Menu
  if (deltaEncodeur != 0) {
    if (modeActuel == MODE_HISTORIQUE && nbMesuresStockees > 0) {
      indexHistorique += deltaEncodeur;
      if (indexHistorique < 0) indexHistorique = 0;
      if (indexHistorique >= nbMesuresStockees) indexHistorique = nbMesuresStockees - 1;
    } else if (modeActuel == MODE_OPTIONS) {
      optionSelectionnee = (optionSelectionnee == 0) ? 1 : 0;
    }
    deltaEncodeur = 0;
  }

  bool lectureSW = digitalRead(PIN_ENC_SW);
  if (lectureSW == LOW) {
    if (!boutonEstEnfonce) {
      boutonEstEnfonce = true;
      tempsDebutEnfonce = maintenant;
    }
    dureeAppuiCourante = maintenant - tempsDebutEnfonce;
  } else {
    if (boutonEstEnfonce) {
      unsigned long dureeTotale = maintenant - tempsDebutEnfonce;
      boutonEstEnfonce = false;
      dureeAppuiCourante = 0;

      if (dureeTotale >= SEUIL_APPUI_LONG_MS) {
        if (modeActuel == MODE_NORMAL && !acquisitionEnCours) {
          acquisitionEnCours = true;
          compteurEchantillons = 0;
          sommeBpm = 0;
        } else if (modeActuel == MODE_OPTIONS) {
          if (optionSelectionnee == 0) {
            langueActive = (langueActive == FR) ? EN : FR;
            EEPROM.write(ADRESSE_LANGUE, (uint8_t)langueActive);
          } else {
            effacerHistoriqueEEPROM();
          }
        }
      } else if (dureeTotale >= SEUIL_APPUI_COURT_MS) {
        if (modeActuel == MODE_NORMAL) modeActuel = MODE_HISTORIQUE;
        else if (modeActuel == MODE_HISTORIQUE) modeActuel = MODE_OPTIONS;
        else modeActuel = MODE_NORMAL;
      }
    }
  }

  // Moyenne EEPROM sur 10 points
  if (acquisitionEnCours && (maintenant - dernierEchantillonMoyenne >= 150)) {
    dernierEchantillonMoyenne = maintenant;
    int mesureBpm = (bpmAffiche > 0) ? bpmAffiche : 70;
    sommeBpm += mesureBpm;
    compteurEchantillons++;

    if (compteurEchantillons >= 10) {
      uint8_t bpmMoyen = (uint8_t)(sommeBpm / 10);
      acquisitionEnCours = false;
      sauvegarderMesure(bpmMoyen, Rtc.GetDateTime());
      indexHistorique = nbMesuresStockees - 1;
    }
  }

  // Rafraîchissement des écrans
  unsigned long intervalleEcran1 = (boutonEstEnfonce || acquisitionEnCours) ? 100 : 1000;
  if (maintenant - dernierAffichageHeure >= intervalleEcran1) {
    dernierAffichageHeure = maintenant;
    RtcDateTime dtRTC = Rtc.GetDateTime();
    snprintf(strHeure, sizeof(strHeure), "%02d:%02d:%02d", dtRTC.Hour(), dtRTC.Minute(), dtRTC.Second());
    dessinerEcran1();
  }

  if (maintenant - dernierAffichagePPG >= 60) {
    dernierAffichagePPG = maintenant;
    dessinerEcran2();
  }
}

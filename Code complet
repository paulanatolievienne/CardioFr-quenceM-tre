// =============================================================================
// 9. SETUP
// =============================================================================
void setup() {
  Serial.begin(115200);

  pinMode(PIN_PPG, INPUT);

  pinMode(PIN_LED_ROUGE, OUTPUT);
  pinMode(PIN_LED_VERT, OUTPUT);
  pinMode(PIN_LED_BLEU, OUTPUT);

  pinMode(PIN_BUZZER, OUTPUT);
  pinMode(PIN_BOUTON_MUTE, INPUT_PULLUP);

  pinMode(PIN_ENC_A, INPUT_PULLUP);
  pinMode(PIN_ENC_B, INPUT_PULLUP);
  pinMode(PIN_ENC_SW, INPUT_PULLUP);

  // PCINT sur D10 et D12
  cli();
  PCICR |= (1 << PCIE0);
  PCMSK0 |= (1 << PCINT2) | (1 << PCINT4);
  sei();

  Rtc.Begin();
  if (Rtc.GetIsWriteProtected()) Rtc.SetIsWriteProtected(false);
  if (!Rtc.GetIsRunning()) Rtc.SetIsRunning(true);

  ecran1.begin();
  ecran2.begin();

  initialiserEEPROM();

  for (byte i = 0; i < LARGEUR_TRACE; i++) {
    bufferPPG[i] = 0;
  }

  Serial.println(F("=== SYSTEME STABILISE ==="));
}

// =============================================================================
// 10. LOOP
// =============================================================================
void loop() {
  unsigned long maintenant = millis();

  // ---------------------------------------------------------------------------
  // A. TRAITEMENT DU SIGNAL PPG (Cadencé à 100 Hz / 10 ms)
  // ---------------------------------------------------------------------------
  if (maintenant - derniereLecturePPG >= PERIODE_ECH_MS) {
    derniereLecturePPG = maintenant;

    int brut = analogRead(PIN_PPG);

    // Détection contact : brut > 200 confirme la présence du doigt sur le capteur
    bool nouveauContact = (brut > 200 && brut < 980);

    if (!nouveauContact) {
      doigtPresent = false;
      bpmFinal = 0.0f;
      signalNorm = 0.0f;
      enPic = false;
      // Remise à zéro immédiate du buffer BPM pour éviter de garder l'ancienne valeur
      for (byte b = 0; b < TAILLE_BUFF_BPM; b++) buffBpm[b] = 0;
      actualiserEtatSante();
    } else {
      doigtPresent = true;

      if (!ppgInitialise) {
        signalLisse = brut;
        ligneBase   = brut;
        ppgInitialise = true;
      }

      // Filtrage passe-bas et suivi de composante continue
      signalLisse += 0.25f * (brut - signalLisse);
      ligneBase   += 0.025f * (signalLisse - ligneBase);
      float ac = signalLisse - ligneBase;

      // Suivi d'amplitude crête
      if (abs(ac) > creteMax) {
        creteMax = abs(ac);
      } else {
        creteMax *= 0.992f;
        if (creteMax < 25.0f) creteMax = 25.0f;
      }

      // Normalisation symétrique centrée autour de 0.5
      signalNorm = 0.5f + (ac / (2.0f * creteMax));
      if (signalNorm > 1.0f) signalNorm = 1.0f;
      if (signalNorm < 0.0f) signalNorm = 0.0f;

      // Détection de pic par trigger de Schmitt
      if (!enPic) {
        if (signalNorm > SEUIL_HAUT && (maintenant - tempsDernierBattement > TEMPS_REFRACTAIRE_MS)) {
          enPic = true;
          unsigned long deltaT = maintenant - tempsDernierBattement;
          tempsDernierBattement = maintenant;

          // Plage physiologique valide : 320 ms à 1700 ms (~35 à 185 BPM)
          if (deltaT >= TEMPS_REFRACTAIRE_MS && deltaT <= 1700) {
            float bpmInst = 60000.0f / (float)deltaT;
            
            // Rejet des artefacts sévères si un rythme est déjà établi
            bool valide = true;
            if (bpmFinal > 35.0f) {
              float diff = abs(bpmInst - bpmFinal);
              if (diff > (bpmFinal * 0.40f)) valide = false;
            }

            if (valide) {
              buffBpm[indexBuffBpm] = bpmInst;
              indexBuffBpm = (indexBuffBpm + 1) % TAILLE_BUFF_BPM;

              float somme = 0;
              byte compte = 0;
              for (byte i = 0; i < TAILLE_BUFF_BPM; i++) {
                if (buffBpm[i] > 0) {
                  somme += buffBpm[i];
                  compte++;
                }
              }
              if (compte > 0) bpmFinal = somme / compte;

              // Déclenchement du bip sonore au tempo réel
              declencherBip(bpmFinal);
            }
          }
        }
      } else {
        // Réarmement dès redescente
        if (signalNorm < SEUIL_BAS) {
          enPic = false;
        }
      }

      actualiserEtatSante();
    }

    // Mise en tampon oscilloscope
    unsigned int dt = ECHELLES_MS[indexEchelle];
    if (maintenant - dernierTempsTrace >= dt) {
      dernierTempsTrace = maintenant;
      uint8_t pixelH = (uint8_t)(signalNorm * (HAUTEUR_TRACE - 2));
      bufferPPG[indexTrace] = pixelH;
      indexTrace = (indexTrace + 1) % LARGEUR_TRACE;
    }
  }

  // ---------------------------------------------------------------------------
  // B. ACTIONNEURS : LED RGB
  // ---------------------------------------------------------------------------
  piloterLedRGB();

  // Bouton Mute FS4 (D9)
  bool lectureMute = digitalRead(PIN_BOUTON_MUTE);
  if (lectureMute != dernierEtatMute && (maintenant - dernierDebounceMute > 50)) {
    if (lectureMute == LOW) {
      sonActive = !sonActive;
      if (!sonActive) noTone(PIN_BUZZER);
    }
    dernierDebounceMute = maintenant;
  }
  dernierEtatMute = lectureMute;

  // ---------------------------------------------------------------------------
  // C. ENCODEUR ET MENU (FS6)
  // ---------------------------------------------------------------------------
  if (deltaEncodeur != 0) {
    if (modeActuel == MODE_HISTORIQUE && nbMesuresStockees > 0) {
      indexHistorique += deltaEncodeur;
      if (indexHistorique < 0) indexHistorique = 0;
      if (indexHistorique >= nbMesuresStockees) indexHistorique = nbMesuresStockees - 1;
    } else if (modeActuel == MODE_OPTIONS) {
      optionSelectionnee = (optionSelectionnee == 0) ? 1 : 0;
    }
    deltaEncodeur = 0;
  }

  bool lectureSW = digitalRead(PIN_ENC_SW);
  if (lectureSW == LOW) {
    if (!boutonEstEnfonce) {
      boutonEstEnfonce = true;
      tempsDebutEnfonce = maintenant;
    }
    dureeAppuiCourante = maintenant - tempsDebutEnfonce;
  } else {
    if (boutonEstEnfonce) {
      unsigned long dureeTotale = maintenant - tempsDebutEnfonce;
      boutonEstEnfonce = false;
      dureeAppuiCourante = 0;

      if (dureeTotale >= SEUIL_APPUI_LONG_MS) {
        if (modeActuel == MODE_NORMAL && !acquisitionEnCours) {
          acquisitionEnCours = true;
          compteurEchantillons = 0;
          sommeBpm = 0;
        } else if (modeActuel == MODE_OPTIONS) {
          if (optionSelectionnee == 0) {
            langueActive = (langueActive == FR) ? EN : FR;
            EEPROM.write(ADRESSE_LANGUE, (uint8_t)langueActive);
          } else {
            effacerHistoriqueEEPROM();
          }
        }
      } else if (dureeTotale >= SEUIL_APPUI_COURT_MS) {
        if (modeActuel == MODE_NORMAL) modeActuel = MODE_HISTORIQUE;
        else if (modeActuel == MODE_HISTORIQUE) modeActuel = MODE_OPTIONS;
        else modeActuel = MODE_NORMAL;
      }
    }
  }

  // Calcul moyenne sur 10 points
  if (acquisitionEnCours && (maintenant - dernierEchantillonMoyenne >= 150)) {
    dernierEchantillonMoyenne = maintenant;
    int bpmInst = (bpmFinal > 0) ? (int)(bpmFinal + 0.5f) : 72;
    sommeBpm += bpmInst;
    compteurEchantillons++;

    if (compteurEchantillons >= 10) {
      uint8_t bpmMoyen = (uint8_t)(sommeBpm / 10);
      acquisitionEnCours = false;
      sauvegarderMesure(bpmMoyen, Rtc.GetDateTime());
      indexHistorique = nbMesuresStockees - 1;
    }
  }

  // ---------------------------------------------------------------------------
  // D. RAFRAÎCHISSEMENT SÉPARÉ DES ÉCRANS
  // ---------------------------------------------------------------------------
  // Écran 1 : mis à jour toutes les secondes (ou 100 ms si un appui est en cours)
  unsigned long intervalleEcran1 = (boutonEstEnfonce || acquisitionEnCours) ? 100 : 1000;
  if (maintenant - dernierAffichageHeure >= intervalleEcran1) {
    dernierAffichageHeure = maintenant;
    RtcDateTime dtRTC = Rtc.GetDateTime();
    snprintf(strHeure, sizeof(strHeure), "%02d:%02d:%02d", dtRTC.Hour(), dtRTC.Minute(), dtRTC.Second());
    dessinerEcran1();
  }

  // Écran 2 (Oscilloscope PPG) : rafraîchi à cadence fluide
  if (maintenant - dernierAffichagePPG >= 75) {
    dernierAffichagePPG = maintenant;
    dessinerEcran2();
  }
}

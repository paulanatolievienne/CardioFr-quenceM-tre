#include <Arduino.h>
#include <EEPROM.h>
#include <U8g2lib.h>
#include <ThreeWire.h>
#include <RtcDS1302.h>

// =============================================================================
// 1. CONFIGURATION MATÉRIELLE DES BROCHES
// =============================================================================
// FS1 : Capteur PPG
const byte PIN_PPG = A0;

// FS2 : RTC DS1302
const int RST_PIN = 2; // CE
const int DAT_PIN = 3; // IO
const int CLK_PIN = 4; // SCLK
ThreeWire monFil(DAT_PIN, CLK_PIN, RST_PIN);
RtcDS1302<ThreeWire> Rtc(monFil);

// FS3 : LED RGB (Cathode commune au GND)
const byte PIN_LED_BLEU  = 6; // D6
const byte PIN_LED_VERT  = 7; // D7
const byte PIN_LED_ROUGE = 8; // D8

// FS4 : Buzzer piézo & Bouton Mute
const byte PIN_BUZZER      = 5; // D5
const byte PIN_BOUTON_MUTE = 9; // D9 (câblé vers GND)

// FS5 & FS6 : Encodeur rotatif EC11
const byte PIN_ENC_A  = 10; // D10 (PB2)
const byte PIN_ENC_B  = 12; // D12 (PB4)
const byte PIN_ENC_SW = 11; // D11 (Axe poussoir vers GND)

// FS5 : Double écran OLED Software I2C
U8G2_SSD1306_128X64_NONAME_1_SW_I2C ecran1(U8G2_R0, /* clock=*/ A4, /* data=*/ A3, /* reset=*/ U8X8_PIN_NONE);
U8G2_SSD1306_128X64_NONAME_1_SW_I2C ecran2(U8G2_R0, /* clock=*/ A2, /* data=*/ A1, /* reset=*/ U8X8_PIN_NONE);

// =============================================================================
// 2. PARAMÈTRES ET STRUCTURES EEPROM (FS6)
// =============================================================================
#define ADRESSE_MAGIC       0    
#define ADRESSE_NB_MESURES  2    
#define ADRESSE_LANGUE      3    
#define ADRESSE_DEBUT_DATA  4    
#define MAX_MESURES         10
const uint16_t EEPROM_MAGIC = 0xCAFE;

struct MesureEEPROM {
  uint8_t bpm;
  uint8_t jour;
  uint8_t mois;
  uint8_t annee; // offset par rapport à 2000
  uint8_t heure;
  uint8_t minute;
  uint8_t seconde;
};

enum Langue { FR = 0, EN = 1 };
Langue langueActive = FR;

enum ModeEcran { MODE_NORMAL, MODE_HISTORIQUE, MODE_OPTIONS };
ModeEcran modeActuel = MODE_NORMAL;

int indexHistorique = 0;
uint8_t nbMesuresStockees = 0;
byte optionSelectionnee = 0; // 0 = Langue, 1 = Effacer

// Moyenne de 10 points (ET6.2)
bool acquisitionEnCours = false;
uint8_t compteurEchantillons = 0;
uint16_t sommeBpm = 0;
unsigned long dernierEchantillonMoyenne = 0;

// Seuils d'appui sur l'axe encodeur (D11)
const unsigned long SEUIL_APPUI_COURT_MS = 2000;
const unsigned long SEUIL_APPUI_LONG_MS  = 6000;
bool boutonEstEnfonce = false;
unsigned long tempsDebutEnfonce = 0;
unsigned long dureeAppuiCourante = 0;

// =============================================================================
// 3. PARAMÈTRES FS1 (TRAITEMENT DU SIGNAL PPG RÉEL WPSE340)
// =============================================================================
const unsigned long PERIODE_ECH_MS = 10; // 100 Hz
const float ALPHA_LISSE = 0.15f;  // Filtrage passe-bas réactif
const float ALPHA_BASE  = 0.003f; // Suivi de composante continue (DC)
const float ALPHA_DECAY = 0.995f; // Décroissance d'enveloppe plus souple

float signalLisse = 0.0f;
float ligneBase   = 0.0f;
float creteMax    = 8.0f;
bool ppgInitialise = false;
unsigned long derniereLecturePPG = 0;

// Seuils adaptés à l'amplitude réelle du capteur
const float SEUIL_HAUT = 0.50f; // Déclenchement au passage du pic systolique
const float SEUIL_BAS  = 0.25f; // Réarmement diastolique
const unsigned long TEMPS_REFRACTAIRE_MS = 400; // Période réfractaire (~155 BPM max)
bool enPic = false;
unsigned long tempsDernierBattement = 0;

const byte TAILLE_BUFF_BPM = 5;
float buffBpm[TAILLE_BUFF_BPM] = {0};
byte indexBuffBpm = 0;
float bpmFinal = 0.0f;
bool doigtPresent = false;
float signalNorm = 0.0f;

// =============================================================================
// 4. PARAMÈTRES FS3 (LED RGB) & FS4 (BUZZER)
// =============================================================================
const float SEUIL_BRADYCARDIE = 60.0f;
const float SEUIL_TACHYCARDIE = 100.0f;
const float BPM_MIN_VALIDE    = 35.0f;
const float BPM_MAX_VALIDE    = 220.0f;

enum EtatSante { SANTE_ETEINT, SANTE_JAUNE, SANTE_VERT, SANTE_ROUGE };
EtatSante etatSanteCourant = SANTE_ETEINT;

const unsigned int FREQ_GRAVE   = 440;
const unsigned int FREQ_MODEREE = 880;
const unsigned int FREQ_AIGUE   = 1760;
const unsigned long DUREE_BIP_MS = 40;

unsigned long debutBip = 0;
bool sonEnCours = false;
bool sonActive = true;
bool dernierEtatMute = HIGH;
unsigned long dernierDebounceMute = 0;

// =============================================================================
// 5. PARAMÈTRES FS5 (OSCILLOSCOPE & AFFICHAGE)
// =============================================================================
const byte LARGEUR_TRACE = 88;
const byte HAUTEUR_TRACE = 36;
const byte Y_BASE = 54;
uint8_t bufferPPG[LARGEUR_TRACE];
byte indexTrace = 0;

const uint8_t NB_ECHELLES = 3;
const unsigned int ECHELLES_MS[NB_ECHELLES] = {10, 25, 50};
const char NOMS_ECHELLES[3][8] = {"10ms", "25ms", "50ms"};
volatile int8_t indexEchelle = 1;

unsigned long dernierTempsTrace = 0;
unsigned long dernierAffichagePPG = 0;
unsigned long dernierAffichageHeure = 0;
char strHeure[9] = "00:00:00";

// Interruption Encodeur
volatile int deltaEncodeur = 0;
volatile unsigned long dernierTempsInterruption = 0;

ISR(PCINT0_vect) {
  uint8_t etatA = (PINB & (1 << PINB2)) ? HIGH : LOW; // D10
  uint8_t etatB = (PINB & (1 << PINB4)) ? HIGH : LOW; // D12

  unsigned long maintenant = millis();
  if (etatA == LOW && (maintenant - dernierTempsInterruption > 40)) {
    dernierTempsInterruption = maintenant;
    if (etatB == HIGH) {
      deltaEncodeur++;
      if (modeActuel == MODE_NORMAL && indexEchelle < NB_ECHELLES - 1) indexEchelle++;
    } else {
      deltaEncodeur--;
      if (modeActuel == MODE_NORMAL && indexEchelle > 0) indexEchelle--;
    }
  }
}

// =============================================================================
// 6. GESTION EEPROM (FS6)
// =============================================================================
void initialiserEEPROM() {
  uint16_t magic;
  EEPROM.get(ADRESSE_MAGIC, magic);
  if (magic != EEPROM_MAGIC) {
    EEPROM.put(ADRESSE_MAGIC, EEPROM_MAGIC);
    nbMesuresStockees = 0;
    EEPROM.write(ADRESSE_NB_MESURES, 0);
    langueActive = FR;
    EEPROM.write(ADRESSE_LANGUE, (uint8_t)FR);
  } else {
    nbMesuresStockees = EEPROM.read(ADRESSE_NB_MESURES);
    if (nbMesuresStockees > MAX_MESURES) nbMesuresStockees = 0;
    langueActive = (Langue)EEPROM.read(ADRESSE_LANGUE);
    if (langueActive > EN) langueActive = FR;
  }
}

void effacerHistoriqueEEPROM() {
  nbMesuresStockees = 0;
  EEPROM.write(ADRESSE_NB_MESURES, 0);
  indexHistorique = 0;
}

void sauvegarderMesure(uint8_t bpmMoyen, RtcDateTime dt) {
  MesureEEPROM m;
  m.bpm = bpmMoyen;
  m.jour = dt.Day();
  m.mois = dt.Month();
  m.annee = (uint8_t)(dt.Year() - 2000);
  m.heure = dt.Hour();
  m.minute = dt.Minute();
  m.seconde = dt.Second();

  if (nbMesuresStockees >= MAX_MESURES) {
    for (int i = 0; i < MAX_MESURES - 1; i++) {
      MesureEEPROM temp;
      EEPROM.get(ADRESSE_DEBUT_DATA + (i + 1) * sizeof(MesureEEPROM), temp);
      EEPROM.put(ADRESSE_DEBUT_DATA + i * sizeof(MesureEEPROM), temp);
    }
    nbMesuresStockees = MAX_MESURES - 1;
  }

  int adresse = ADRESSE_DEBUT_DATA + nbMesuresStockees * sizeof(MesureEEPROM);
  EEPROM.put(adresse, m);
  nbMesuresStockees++;
  EEPROM.write(ADRESSE_NB_MESURES, nbMesuresStockees);
}

MesureEEPROM lireMesure(uint8_t index) {
  MesureEEPROM m;
  int adresse = ADRESSE_DEBUT_DATA + index * sizeof(MesureEEPROM);
  EEPROM.get(adresse, m);
  return m;
}

// =============================================================================
// 7. GESTION ACTIONNEURS : LED RGB (FS3) & BUZZER (FS4)
// =============================================================================
void actualiserEtatSante() {
  if (!doigtPresent || bpmFinal < BPM_MIN_VALIDE || bpmFinal > BPM_MAX_VALIDE) {
    etatSanteCourant = SANTE_ETEINT;
  } else if (bpmFinal < SEUIL_BRADYCARDIE) {
    etatSanteCourant = SANTE_JAUNE;
  } else if (bpmFinal <= SEUIL_TACHYCARDIE) {
    etatSanteCourant = SANTE_VERT;
  } else {
    etatSanteCourant = SANTE_ROUGE;
  }
}

void piloterLedRGB() {
  switch (etatSanteCourant) {
    case SANTE_ETEINT:
      digitalWrite(PIN_LED_ROUGE, LOW);
      digitalWrite(PIN_LED_VERT, LOW);
      digitalWrite(PIN_LED_BLEU, LOW);
      break;

    case SANTE_VERT:
      digitalWrite(PIN_LED_ROUGE, LOW);
      digitalWrite(PIN_LED_VERT, HIGH);
      digitalWrite(PIN_LED_BLEU, LOW);
      break;

    case SANTE_ROUGE:
      digitalWrite(PIN_LED_ROUGE, HIGH);
      digitalWrite(PIN_LED_VERT, LOW);
      digitalWrite(PIN_LED_BLEU, LOW);
      break;

    case SANTE_JAUNE:
      digitalWrite(PIN_LED_BLEU, LOW);
      digitalWrite(PIN_LED_ROUGE, HIGH);
      // Hachage logiciel du vert pour compenser la sensibilité lumineuse
      static byte cptHachage = 0;
      cptHachage = (cptHachage + 1) % 4;
      digitalWrite(PIN_LED_VERT, (cptHachage == 0) ? HIGH : LOW);
      break;
  }
}

void declencherBip(float bpm) {
  if (!sonActive || !doigtPresent || bpm < BPM_MIN_VALIDE || bpm > BPM_MAX_VALIDE) {
    return;
  }

  unsigned int freq = FREQ_MODEREE;
  if (bpm < SEUIL_BRADYCARDIE) {
    freq = FREQ_GRAVE;
  } else if (bpm > SEUIL_TACHYCARDIE) {
    freq = FREQ_AIGUE;
  }

  tone(PIN_BUZZER, freq);
  debutBip = millis();
  sonEnCours = true;
}

void gererFinBip() {
  if (sonEnCours && (millis() - debutBip >= DUREE_BIP_MS)) {
    noTone(PIN_BUZZER);
    sonEnCours = false;
  }
}


#include <Arduino.h>
#include <U8g2lib.h>
#include <RtcDS1302.h>
#include <ThreeWire.h>
#include <EEPROM.h>

// ============================================================
// PINS
// ============================================================

#define OLED1_SCL A4
#define OLED1_SDA A3
#define OLED2_SCL A2
#define OLED2_SDA A1

const int pinEncA  = 10;
const int pinEncB  = 12;
const int pinEncSW = 11;

const int rtcRST = 2;
const int rtcDAT = 3;
const int rtcCLK = 4;

const int buzzerPin = 5;

const int ledYellow = 6;
const int ledGreen  = 7;
const int ledRed    = 8;

const int buttonPin = 9;
const int ppgPin = A0;

// ============================================================
// OLED
// ============================================================

U8G2_SSD1306_128X64_NONAME_1_SW_I2C u8g2_1(
    U8G2_R0,
    OLED1_SCL,
    OLED1_SDA,
    U8X8_PIN_NONE
);

U8G2_SSD1306_128X64_NONAME_1_SW_I2C u8g2_2(
    U8G2_R0,
    OLED2_SCL,
    OLED2_SDA,
    U8X8_PIN_NONE
);

// ============================================================
// RTC
// ============================================================

ThreeWire myWire(rtcDAT, rtcCLK, rtcRST);
RtcDS1302<ThreeWire> Rtc(myWire);

// ============================================================
// MODES
// ============================================================

enum SystemMode {
    MODE_NORMAL,
    MODE_MENU
};

SystemMode systemMode = MODE_NORMAL;

// ============================================================
// ENCODEUR
// ============================================================

int timeBaseIndex = 0;

const int timeBases[3] = {
    10,
    20,
    40
};

int menuRecordIndex = 0;

// Détection simple de l'encodeur
bool lastEncA = HIGH;

// ============================================================
// BPM
// ============================================================

const int BPM_MIN = 40;
const int BPM_MAX = 200;

float displayedBPM = 0;

unsigned long lastBeatTime = 0;
unsigned long lastSignalTime = 0;

bool beatDetected = false;

int signalAverage = 512;
int signalAmplitude = 0;

const int FILTER_SIZE = 16;
int filterBuffer[FILTER_SIZE];
int filterIndex = 0;

long filterSum = 0;

int threshold = 0;

const unsigned long MIN_BEAT_INTERVAL = 300;
const unsigned long MAX_BEAT_INTERVAL = 2000;

const unsigned long SIGNAL_TIMEOUT = 2500;

// ============================================================
// EEPROM
// ============================================================

#define EEPROM_MAGIC 0x42

struct Measurement {
    byte hour;
    byte minute;
    byte day;
    byte month;
    byte bpm;
};

const int EEPROM_START = 10;
const int MAX_RECORDS = 20;

int recordCount = 0;

// ============================================================
// MOYENNE DES 10 MESURES
// ============================================================

int bpmMeasurements[10];
int bpmMeasurementCount = 0;

// ============================================================
// GRAPHIQUE PPG
// ============================================================

#define GRAPH_WIDTH 96

int graphValues[GRAPH_WIDTH];

int graphIndex = 0;

unsigned long lastGraphSample = 0;

// ============================================================
// BUZZER
// ============================================================

bool buzzerMuted = false;
unsigned long lastBuzzerTime = 0;

// ============================================================
// BOUTONS
// ============================================================

bool lastButtonState = HIGH;
bool lastEncoderButtonState = HIGH;

unsigned long buttonPressStart = 0;
unsigned long encoderButtonPressStart = 0;

// ============================================================
// FONCTIONS EEPROM
// ============================================================

void loadEEPROM() {

    if (EEPROM.read(0) != EEPROM_MAGIC) {
        recordCount = 0;
        return;
    }

    recordCount = EEPROM.read(1);

    if (recordCount < 0 || recordCount > MAX_RECORDS) {
        recordCount = 0;
    }
}

void saveRecord(const Measurement &m) {

    if (recordCount >= MAX_RECORDS) {
        recordCount = 0;
    }

    int address = EEPROM_START + recordCount * sizeof(Measurement);

    EEPROM.put(address, m);

    recordCount++;

    EEPROM.update(0, EEPROM_MAGIC);
    EEPROM.update(1, recordCount);
}

Measurement readRecord(int index) {

    Measurement m;

    if (index < 0 || index >= recordCount) {
        m.hour = 0;
        m.minute = 0;
        m.day = 0;
        m.month = 0;
        m.bpm = 0;
        return m;
    }

    int address = EEPROM_START + index * sizeof(Measurement);

    EEPROM.get(address, m);

    return m;
}

void clearEEPROM() {

    EEPROM.update(0, 0);
    EEPROM.update(1, 0);

    recordCount = 0;
    menuRecordIndex = 0;
}

// ============================================================
// SAUVEGARDE MOYENNE DE 10 MESURES
// ============================================================

void addBPMMeasurement(int bpm) {

    if (bpm < BPM_MIN || bpm > BPM_MAX) {
        return;
    }

    if (bpmMeasurementCount < 10) {

        bpmMeasurements[bpmMeasurementCount] = bpm;
        bpmMeasurementCount++;
    }

    if (bpmMeasurementCount >= 10) {

        long total = 0;

        for (int i = 0; i < 10; i++) {
            total += bpmMeasurements[i];
        }

        int average = total / 10;

        RtcDateTime now = Rtc.GetDateTime();

        Measurement m;

        m.hour = now.Hour();
        m.minute = now.Minute();
        m.day = now.Day();
        m.month = now.Month();
        m.bpm = average;

        saveRecord(m);

        bpmMeasurementCount = 0;
    }
}

// ============================================================
// LEDS
// ============================================================

void updateLEDs(int bpm) {

    digitalWrite(ledYellow, LOW);
    digitalWrite(ledGreen, LOW);
    digitalWrite(ledRed, LOW);

    if (bpm < BPM_MIN || bpm > BPM_MAX) {
        return;
    }

    if (bpm < 60) {
        digitalWrite(ledYellow, HIGH);
    }
    else if (bpm <= 100) {
        digitalWrite(ledGreen, HIGH);
    }
    else {
        digitalWrite(ledRed, HIGH);
    }
}

// ============================================================
// BUZZER
// ============================================================

void beepForBPM(int bpm) {

    if (buzzerMuted) {
        return;
    }

    if (bpm < BPM_MIN || bpm > BPM_MAX) {
        return;
    }

    int frequency;

    if (bpm < 60) {
        frequency = 600;
    }
    else if (bpm <= 100) {
        frequency = 1000;
    }
    else {
        frequency = 1800;
    }

    tone(buzzerPin, frequency, 60);
}

// ============================================================
// FILTRAGE PPG
// ============================================================

int readFilteredPPG() {

    int value = analogRead(ppgPin);

    filterSum -= filterBuffer[filterIndex];

    filterBuffer[filterIndex] = value;

    filterSum += value;

    filterIndex++;

    if (filterIndex >= FILTER_SIZE) {
        filterIndex = 0;
    }

    return filterSum / FILTER_SIZE;
}

// ============================================================
// DETECTION DU BATTEMENT
// ============================================================

void processPPG() {

    int signal = readFilteredPPG();

    signalAverage = (signalAverage * 15 + signal) / 16;

    int centeredSignal = signal - signalAverage;

    int absoluteSignal = abs(centeredSignal);

    signalAmplitude = (signalAmplitude * 15 + absoluteSignal) / 16;

    threshold = (signalAmplitude * 65) / 100;

    unsigned long now = millis();

    // --------------------------------------------------------
    // Détection avec seuil
    // --------------------------------------------------------

    if (!beatDetected) {

        if (centeredSignal > threshold) {

            unsigned long interval = now - lastBeatTime;

            if (interval >= MIN_BEAT_INTERVAL &&
                interval <= MAX_BEAT_INTERVAL) {

                int bpm = 60000 / interval;

                if (bpm >= BPM_MIN && bpm <= BPM_MAX) {

                    displayedBPM =
                        (displayedBPM * 2.0 + bpm) / 3.0;

                    addBPMMeasurement(bpm);

                    updateLEDs((int)displayedBPM);

                    beepForBPM((int)displayedBPM);

                    lastBeatTime = now;
                    lastSignalTime = now;

                    beatDetected = true;
                }
            }
            else if (lastBeatTime == 0) {

                lastBeatTime = now;
            }
        }
    }
    else {

        // Hystérésis
        if (centeredSignal < threshold * 0.40) {
            beatDetected = false;
        }
    }

    // --------------------------------------------------------
    // Timeout
    // --------------------------------------------------------

    if (lastBeatTime != 0 &&
        now - lastBeatTime > SIGNAL_TIMEOUT) {

        displayedBPM = 0;

        digitalWrite(ledYellow, LOW);
        digitalWrite(ledGreen, LOW);
        digitalWrite(ledRed, LOW);
    }

    // --------------------------------------------------------
    // Graphique
    // --------------------------------------------------------

    unsigned long graphPeriod =
        (unsigned long)timeBases[timeBaseIndex];

    if (now - lastGraphSample >= graphPeriod) {

        lastGraphSample = now;

        graphValues[graphIndex] = signal;

        graphIndex++;

        if (graphIndex >= GRAPH_WIDTH) {
            graphIndex = 0;
        }
    }
}

// ============================================================
// ECRAN 1
// ============================================================

void drawScreen1() {

    u8g2_1.firstPage();

    do {

        u8g2_1.setFont(u8g2_font_6x10_tr);

        if (systemMode == MODE_NORMAL) {

            RtcDateTime now = Rtc.GetDateTime();

            char timeText[10];

            snprintf(
                timeText,
                sizeof(timeText),
                "%02d:%02d:%02d",
                now.Hour(),
                now.Minute(),
                now.Second()
            );

            u8g2_1.drawStr(0, 10, timeText);

            u8g2_1.drawStr(0, 27, "BPM:");

            if (displayedBPM > 0) {

                char bpmText[10];

                snprintf(
                    bpmText,
                    sizeof(bpmText),
                    "%d",
                    (int)displayedBPM
                );

                u8g2_1.drawStr(35, 27, bpmText);
            }
            else {

                u8g2_1.drawStr(35, 27, "--");
            }

            u8g2_1.drawStr(0, 45, "PPG Cardio");

            u8g2_1.drawStr(
                0,
                60,
                buzzerMuted ? "Buzzer OFF" : "Buzzer ON"
            );
        }

        else {

            u8g2_1.drawStr(0, 10, "MENU EEPROM");

            if (recordCount == 0) {

                u8g2_1.drawStr(0, 30, "Aucune mesure");
            }
            else {

                Measurement m =
                    readRecord(menuRecordIndex);

                char line[25];

                snprintf(
                    line,
                    sizeof(line),
                    "%d/%d",
                    menuRecordIndex + 1,
                    recordCount
                );

                u8g2_1.drawStr(0, 25, line);

                snprintf(
                    line,
                    sizeof(line),
                    "%02d:%02d  %d BPM",
                    m.hour,
                    m.minute,
                    m.bpm
                );

                u8g2_1.drawStr(0, 42, line);

                snprintf(
                    line,
                    sizeof(line),
                    "%02d/%02d",
                    m.day,
                    m.month
                );

                u8g2_1.drawStr(0, 58, line);
            }
        }

    } while (u8g2_1.nextPage());
}

// ============================================================
// ECRAN 2
// ============================================================

void drawScreen2() {

    u8g2_2.firstPage();

    do {

        u8g2_2.setFont(u8g2_font_6x10_tr);

        char info[25];

        snprintf(
            info,
            sizeof(info),
            "A0:%d %dms/px",
            signalAverage,
            timeBases[timeBaseIndex]
        );

        u8g2_2.drawStr(0, 9, info);

        // Axe horizontal
        u8g2_2.drawLine(
            15,
            60,
            127,
            60
        );

        // Axe vertical
        u8g2_2.drawLine(
            15,
            15,
            15,
            60
        );

        // Graphique
        for (int x = 0; x < GRAPH_WIDTH - 1; x++) {

            int i1 =
                (graphIndex + x) % GRAPH_WIDTH;

            int i2 =
                (graphIndex + x + 1) % GRAPH_WIDTH;

            int y1 =
                map(
                    graphValues[i1],
                    0,
                    1023,
                    58,
                    18
                );

            int y2 =
                map(
                    graphValues[i2],
                    0,
                    1023,
                    58,
                    18
                );

            u8g2_2.drawLine(
                16 + x,
                y1,
                17 + x,
                y2
            );
        }

    } while (u8g2_2.nextPage());
}

// ============================================================
// ENCODEUR ROTATIF
// ============================================================

void processEncoder() {

    bool encA = digitalRead(pinEncA);
    bool encB = digitalRead(pinEncB);

    // On détecte le front descendant de A
    if (lastEncA == HIGH && encA == LOW) {

        if (encB == HIGH) {

            // Sens 1
            if (systemMode == MODE_NORMAL) {

                timeBaseIndex++;

                if (timeBaseIndex >= 3) {
                    timeBaseIndex = 0;
                }
            }
            else {

                if (recordCount > 0) {

                    menuRecordIndex++;

                    if (menuRecordIndex >= recordCount) {
                        menuRecordIndex = 0;
                    }
                }
            }
        }

        else {

            // Sens 2
            if (systemMode == MODE_NORMAL) {

                if (timeBaseIndex == 0) {
                    timeBaseIndex = 2;
                }
                else {
                    timeBaseIndex--;
                }
            }
            else {

                if (recordCount > 0) {

                    if (menuRecordIndex == 0) {
                        menuRecordIndex = recordCount - 1;
                    }
                    else {
                        menuRecordIndex--;
                    }
                }
            }
        }
    }

    lastEncA = encA;
}

// ============================================================
// BOUTON D9
// ============================================================

void processMainButton() {

    bool state = digitalRead(buttonPin);

    if (lastButtonState == HIGH && state == LOW) {

        buttonPressStart = millis();
    }

    if (lastButtonState == LOW && state == HIGH) {

        unsigned long duration =
            millis() - buttonPressStart;

        // Appui court : mute buzzer
        if (duration < 1000) {

            buzzerMuted = !buzzerMuted;

            if (buzzerMuted) {
                noTone(buzzerPin);
            }
        }
    }

    lastButtonState = state;
}

// ============================================================
// BOUTON ENCODEUR D11
// ============================================================

void processEncoderButton() {

    bool state = digitalRead(pinEncSW);

    if (lastEncoderButtonState == HIGH &&
        state == LOW) {

        encoderButtonPressStart = millis();
    }

    if (lastEncoderButtonState == LOW &&
        state == HIGH) {

        unsigned long duration =
            millis() - encoderButtonPressStart;

        // Appui long : effacement EEPROM
        if (duration >= 1500) {

            clearEEPROM();
        }

        // Appui court : menu
        else {

            if (systemMode == MODE_NORMAL) {

                systemMode = MODE_MENU;
                menuRecordIndex = 0;
            }
            else {

                systemMode = MODE_NORMAL;
            }
        }
    }

    lastEncoderButtonState = state;
}

// ============================================================
// SETUP
// ============================================================

void setup() {

    // --------------------------------------------------------
    // Pins
    // --------------------------------------------------------

    pinMode(pinEncA, INPUT_PULLUP);
    pinMode(pinEncB, INPUT_PULLUP);
    pinMode(pinEncSW, INPUT_PULLUP);

    pinMode(buttonPin, INPUT_PULLUP);

    pinMode(buzzerPin, OUTPUT);

    pinMode(ledYellow, OUTPUT);
    pinMode(ledGreen, OUTPUT);
    pinMode(ledRed, OUTPUT);

    digitalWrite(ledYellow, LOW);
    digitalWrite(ledGreen, LOW);
    digitalWrite(ledRed, LOW);

    // --------------------------------------------------------
    // Initialisation OLED
    // --------------------------------------------------------

    u8g2_1.begin();
    u8g2_2.begin();

    // --------------------------------------------------------
    // Initialisation RTC
    // --------------------------------------------------------

    Rtc.Begin();

    // --------------------------------------------------------
    // Initialisation filtre
    // --------------------------------------------------------

    int initialValue = analogRead(ppgPin);

    for (int i = 0; i < FILTER_SIZE; i++) {

        filterBuffer[i] = initialValue;
        filterSum += initialValue;
    }

    signalAverage = initialValue;

    // --------------------------------------------------------
    // Graphique
    // --------------------------------------------------------

    for (int i = 0; i < GRAPH_WIDTH; i++) {
        graphValues[i] = initialValue;
    }

    // --------------------------------------------------------
    // EEPROM
    // --------------------------------------------------------

    loadEEPROM();

    // --------------------------------------------------------
    // Encodeur
    // --------------------------------------------------------

    lastEncA = digitalRead(pinEncA);
}

// ============================================================
// LOOP
// ============================================================

void loop() {

    // Lecture PPG
    processPPG();

    // Encodeur
    processEncoder();

    // Bouton D9
    processMainButton();

    // Bouton de l'encodeur D11
    processEncoderButton();

    // Affichage
    drawScreen1();
    drawScreen2();

    delay(2);
}

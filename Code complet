    }

    // Mode Normal
    if (modeActuel == MODE_NORMAL) {
      ecran1.setFont(u8g2_font_helvB14_tf);
      ecran1.drawStr(22, 22, strHeure);
      ecran1.drawHLine(14, 28, 100);

      ecran1.setFont(u8g2_font_6x10_tf);
      if (acquisitionEnCours) {
        ecran1.drawStr(10, 42, (langueActive == FR) ? "ENREGISTREMENT..." : "RECORDING...");
        ecran1.drawFrame(14, 48, 100, 8);
        ecran1.drawBox(14, 48, compteurEchantillons * 10, 8);

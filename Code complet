// =============================================================================
// 9. INITIALISATION (SETUP)
// =============================================================================
void setup() {
  Serial.begin(115200);

  // Configuration I/O
  pinMode(PIN_PPG, INPUT);

  pinMode(PIN_LED_ROUGE, OUTPUT);
  pinMode(PIN_LED_VERT, OUTPUT);
  pinMode(PIN_LED_BLEU, OUTPUT);

  pinMode(PIN_BUZZER, OUTPUT);
  pinMode(PIN_BOUTON_MUTE, INPUT_PULLUP);

  pinMode(PIN_ENC_A, INPUT_PULLUP);
  pinMode(PIN_ENC_B, INPUT_PULLUP);
  pinMode(PIN_ENC_SW, INPUT_PULLUP);

  // Interruption PCINT pour Encodeur sur D10 et D12
  cli();
  PCICR |= (1 << PCIE0);
  PCMSK0 |= (1 << PCINT2) | (1 << PCINT4);
  sei();

  // Initialisation RTC DS1302
  Rtc.Begin();
  if (Rtc.GetIsWriteProtected()) Rtc.SetIsWriteProtected(false);
  if (!Rtc.GetIsRunning()) Rtc.SetIsRunning(true);

  // Initialisation OLEDs
  ecran1.begin();
  ecran2.begin();

  // Initialisation EEPROM
  initialiserEEPROM();

  for (byte i = 0; i < LARGEUR_TRACE; i++) {
    bufferPPG[i] = 0;
  }

  Serial.println(F("=== SYSTEME CARDIO INTEGRE OPERATIONNEL ==="));
}

// =============================================================================
// 10. BOUCLE PRINCIPALE NON-BLOQUANTE (LOOP)
// =============================================================================
void loop() {
  unsigned long maintenant = millis();

  // ---------------------------------------------------------------------------
  // A. FS1 : TRAITEMENT DU SIGNAL PPG (Version exacte et robuste FS1)
  // ---------------------------------------------------------------------------
  if (maintenant - derniereLecturePPG >= PERIODE_ECH_MS) {
    derniereLecturePPG = maintenant;

    int brut = analogRead(PIN_PPG);
    if (!ppgInitialise) {
      signalLisse = brut;
      ligneBase   = brut;
      ppgInitialise = true;
    }

    // Filtrage récursif conforme FS1
    signalLisse += ALPHA_LISSE * (brut - signalLisse);
    ligneBase   += ALPHA_BASE * (signalLisse - ligneBase);
    float ac = signalLisse - ligneBase;

    // Plage de détection élargie pour ne pas rejeter le doigt
    doigtPresent = (brut > 30 && brut < 1010);

    // Suivi d'enveloppe crête
    if (ac > creteMax) {
      creteMax = ac;
    } else {
      creteMax *= ALPHA_DECAY;
      if (creteMax < 5.0f) creteMax = 5.0f;
    }

    // Normalisation continue [0.0 ; 1.0] pour l'oscilloscope
    if (ac > 0.0f) {
      signalNorm = ac / creteMax;
      if (signalNorm > 1.0f) signalNorm = 1.0f;
    } else {
      signalNorm = 0.0f;
    }

    // Détection des battements cardiaques
    if (!enPic) {
      if (signalNorm > SEUIL_HAUT && (maintenant - tempsDernierBattement > TEMPS_REFRACTAIRE_MS) && doigtPresent) {
        enPic = true;
        unsigned long deltaT = maintenant - tempsDernierBattement;
        tempsDernierBattement = maintenant;

        if (deltaT >= TEMPS_REFRACTAIRE_MS && deltaT <= 1600) {
          float bpmInst = 60000.0f / (float)deltaT;
          bool valide = true;
          if (bpmFinal > 35.0f) {
            float ecart = abs(bpmInst - bpmFinal);
            if (ecart > (bpmFinal * 0.35f)) valide = false;
          }

          if (valide) {
            buffBpm[indexBuffBpm] = bpmInst;
            indexBuffBpm = (indexBuffBpm + 1) % TAILLE_BUFF_BPM;
            float somme = 0;
            byte compte = 0;
            for (byte i = 0; i < TAILLE_BUFF_BPM; i++) {
              if (buffBpm[i] > 0) {
                somme += buffBpm[i];
                compte++;
              }
            }
            if (compte > 0) bpmFinal = somme / compte;

            // Bip sonore synchronisé
            declencherBip(bpmFinal);
          }
        }
      }
    } else {
      if (signalNorm < SEUIL_BAS) {
        enPic = false; // Réarmement
      }
    }

    if (!doigtPresent) {
      bpmFinal = 0.0f;
    }

    // Mise à jour voyant LED d'état de santé
    actualiserEtatSante();
  }

  // ---------------------------------------------------------------------------
  // B. FS3 & FS4 : PILOTAGE PHYSIQUE DES ACTIONNEURS
  // ---------------------------------------------------------------------------
  piloterLedRGB();
  gererFinBip();

  // Bouton Mute FS4 (D9)
  bool lectureMute = digitalRead(PIN_BOUTON_MUTE);
  if (lectureMute != dernierEtatMute && (maintenant - dernierDebounceMute > 50)) {
    if (lectureMute == LOW) {
      sonActive = !sonActive;
      if (!sonActive) {
        noTone(PIN_BUZZER);
        sonEnCours = false;
      }
    }
    dernierDebounceMute = maintenant;
  }
  dernierEtatMute = lectureMute;

  // ---------------------------------------------------------------------------
  // C. FS5 & FS6 : GESTION DE L'ENCODEUR ROTATIF (AXE ET ROTATION)
  // ---------------------------------------------------------------------------
  if (deltaEncodeur != 0) {
    if (modeActuel == MODE_HISTORIQUE && nbMesuresStockees > 0) {
      indexHistorique += deltaEncodeur;
      if (indexHistorique < 0) indexHistorique = 0;
      if (indexHistorique >= nbMesuresStockees) indexHistorique = nbMesuresStockees - 1;
    } else if (modeActuel == MODE_OPTIONS) {
      optionSelectionnee = (optionSelectionnee == 0) ? 1 : 0;
    }
    deltaEncodeur = 0;
  }

  // Lecture continue de l'axe poussoir de l'encodeur (D11)
  bool lectureSW = digitalRead(PIN_ENC_SW);
  if (lectureSW == LOW) {
    if (!boutonEstEnfonce) {
      boutonEstEnfonce = true;
      tempsDebutEnfonce = maintenant;
    }
    dureeAppuiCourante = maintenant - tempsDebutEnfonce;
  } else {
    if (boutonEstEnfonce) {
      unsigned long dureeTotale = maintenant - tempsDebutEnfonce;
      boutonEstEnfonce = false;
      dureeAppuiCourante = 0;

      if (dureeTotale >= SEUIL_APPUI_LONG_MS) {
        // Appui long (>= 6s)
        if (modeActuel == MODE_NORMAL && !acquisitionEnCours) {
          acquisitionEnCours = true;
          compteurEchantillons = 0;
          sommeBpm = 0;
        } else if (modeActuel == MODE_OPTIONS) {
          if (optionSelectionnee == 0) {
            langueActive = (langueActive == FR) ? EN : FR;
            EEPROM.write(ADRESSE_LANGUE, (uint8_t)langueActive);
          } else {
            effacerHistoriqueEEPROM();
          }
        }
      } else if (dureeTotale >= SEUIL_APPUI_COURT_MS) {
        // Appui court (2s à 6s)
        if (modeActuel == MODE_NORMAL) {
          modeActuel = MODE_HISTORIQUE;
        } else if (modeActuel == MODE_HISTORIQUE) {
          modeActuel = MODE_OPTIONS;
        } else {
          modeActuel = MODE_NORMAL;
        }
      }
    }
  }

  // ---------------------------------------------------------------------------
  // D. FS6 : CALCUL DE LA MOYENNE SUR 10 POINTS ET STOCKAGE
  // ---------------------------------------------------------------------------
  if (acquisitionEnCours && (maintenant - dernierEchantillonMoyenne >= 140)) {
    dernierEchantillonMoyenne = maintenant;
    int bpmInst = (bpmFinal > 0) ? (int)(bpmFinal + 0.5f) : 70;
    sommeBpm += bpmInst;
    compteurEchantillons++;

    if (compteurEchantillons >= 10) {
      uint8_t bpmMoyen = (uint8_t)(sommeBpm / 10);
      acquisitionEnCours = false;
      sauvegarderMesure(bpmMoyen, Rtc.GetDateTime());
      indexHistorique = nbMesuresStockees - 1;
    }
  }

  // ---------------------------------------------------------------------------
  // E. FS5 : ACQUISITION DE L'OSCILLOSCOPE SELON LA BASE DE TEMPS
  // ---------------------------------------------------------------------------
  unsigned int dt = ECHELLES_MS[indexEchelle];
  while (maintenant - dernierTempsTrace >= dt) {
    dernierTempsTrace += dt;
    // Injection du signal PPG normalisé réel de FS1
    uint8_t pixelH = (uint8_t)(signalNorm * (HAUTEUR_TRACE - 2));
    bufferPPG[indexTrace] = pixelH;
    indexTrace = (indexTrace + 1) % LARGEUR_TRACE;
  }

  // ---------------------------------------------------------------------------
  // F. RAFRAÎCHISSEMENT DES DEUX ÉCRANS OLED
  // ---------------------------------------------------------------------------
 // Écran 1 (Heure & BPM) : rafraîchi toutes les 500 ms (suffisant pour les secondes)
  if (maintenant - dernierAffichageHeure >= 500) {
    dernierAffichageHeure = maintenant;
    RtcDateTime dtRTC = Rtc.GetDateTime();
    snprintf(strHeure, sizeof(strHeure), "%02d:%02d:%02d", dtRTC.Hour(), dtRTC.Minute(), dtRTC.Second());
    dessinerEcran1();
  }

  // Écran 2 (Oscilloscope PPG) : rafraîchi toutes les 90 ms (~11 FPS, libère du temps CPU)
  if (maintenant - dernierAffichagePPG >= 90) {
    dernierAffichagePPG = maintenant;
    dessinerEcran2();
  }

  // Écran 2 (Oscilloscope PPG) : rafraîchi à ~15 FPS
  if (maintenant - dernierAffichagePPG >= 65) {
    dernierAffichagePPG = maintenant;
    dessinerEcran2();
  }
}

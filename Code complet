// =============================================================================
// 8. INITIALISATION (SETUP)
// =============================================================================
void setup() {
  Serial.begin(115200);

  pinMode(PIN_PPG, INPUT);

  pinMode(PIN_LED_ROUGE, OUTPUT);
  pinMode(PIN_LED_VERT, OUTPUT);
  pinMode(PIN_LED_BLEU, OUTPUT);

  pinMode(PIN_BUZZER, OUTPUT);
  pinMode(PIN_BOUTON_MUTE, INPUT_PULLUP);

  pinMode(PIN_ENC_A, INPUT_PULLUP);
  pinMode(PIN_ENC_B, INPUT_PULLUP);
  pinMode(PIN_ENC_SW, INPUT_PULLUP);

  // Initialisation RTC
  Rtc.Begin();
  if (Rtc.GetIsWriteProtected()) Rtc.SetIsWriteProtected(false);
  if (!Rtc.GetIsRunning()) Rtc.SetIsRunning(true);

  // Initialisation des deux écrans
  ecran1.begin();
  ecran2.begin();

  initialiserEEPROM();

  for (byte i = 0; i < LARGEUR_TRACE; i++) {
    bufferPPG_Interne[i] = 0;
    bufferPPG_Affiche[i] = 0;
  }

  // Interruption PCINT sur l'encodeur (D10 / D12)
  cli();
  PCICR |= (1 << PCIE0);
  PCMSK0 |= (1 << PCINT2) | (1 << PCINT4);

  // Configuration du Timer 1 à 100 Hz strict (10 ms)
  TCCR1A = 0;
  TCCR1B = 0;
  TCNT1  = 0;
  OCR1A = 2499;             // 16MHz / (64 * 100Hz) - 1 = 2499
  TCCR1B |= (1 << WGM12);   // Mode CTC
  TCCR1B |= (1 << CS11) | (1 << CS10); // Prescaler 64
  TIMSK1 |= (1 << OCIE1A);  // Interruption Compare Match A
  sei();

  Serial.println(F("=== SYSTEME COMPLET FINALISE ==="));
}

// =============================================================================
// 9. BOUCLE PRINCIPALE (LOOP)
// =============================================================================
void loop() {
  unsigned long maintenant = millis();

  // 1. Récupération atomique des variables du Timer 1
  cli();
  doigtPresent = doigtPresentVolatile;
  bpmAffiche = bpmCalculeVolatile;
  bool sonBip = nouveauBattement;
  nouveauBattement = false;
  sei();

  // 2. Gestion du Bip au battement et de la LED RGB
  if (sonBip) {
    declencherBip();
  }
  actualiserActionneurs();

  // 3. Bouton Mute FS4 (D9)
  bool lectureMute = digitalRead(PIN_BOUTON_MUTE);
  if (lectureMute != dernierEtatMute && (maintenant - dernierDebounceMute > 50)) {
    if (lectureMute == LOW) {
      sonActive = !sonActive;
      if (!sonActive) noTone(PIN_BUZZER);
    }
    dernierDebounceMute = maintenant;
  }
  dernierEtatMute = lectureMute;

  // 4. Navigation par rotation d'encodeur
  if (deltaEncodeur != 0) {
    if (modeActuel == MODE_HISTORIQUE && nbMesuresStockees > 0) {
      indexHistorique += deltaEncodeur;
      if (indexHistorique < 0) indexHistorique = 0;
      if (indexHistorique >= nbMesuresStockees) indexHistorique = nbMesuresStockees - 1;
    } else if (modeActuel == MODE_OPTIONS) {
      optionSelectionnee = (optionSelectionnee == 0) ? 1 : 0;
    }
    deltaEncodeur = 0;
  }

  // 5. Gestion de l'axe poussoir de l'encodeur (D11)
  bool lectureSW = digitalRead(PIN_ENC_SW);
  if (lectureSW == LOW) {
    if (!boutonEstEnfonce) {
      boutonEstEnfonce = true;
      tempsDebutEnfonce = maintenant;
    }
    dureeAppuiCourante = maintenant - tempsDebutEnfonce;
  } else {
    if (boutonEstEnfonce) {
      unsigned long dureeTotale = maintenant - tempsDebutEnfonce;
      boutonEstEnfonce = false;
      dureeAppuiCourante = 0;

      if (dureeTotale >= SEUIL_APPUI_LONG_MS) {
        // Appui long (>= 5s)
        if (modeActuel == MODE_NORMAL && !acquisitionEnCours) {
          acquisitionEnCours = true;
          compteurEchantillons = 0;
          sommeBpm = 0;
        } else if (modeActuel == MODE_OPTIONS) {
          if (optionSelectionnee == 0) {
            langueActive = (langueActive == FR) ? EN : FR;
            EEPROM.write(ADRESSE_LANGUE, (uint8_t)langueActive);
          } else {
            effacerHistoriqueEEPROM();
          }
        }
      } else if (dureeTotale >= SEUIL_APPUI_COURT_MS) {
        // Appui court (1.5s à 5s)
        if (modeActuel == MODE_NORMAL) modeActuel = MODE_HISTORIQUE;
        else if (modeActuel == MODE_HISTORIQUE) modeActuel = MODE_OPTIONS;
        else modeActuel = MODE_NORMAL;
      }
    }
  }

  // 6. Calcul de la moyenne sur 10 points (FS6)
  if (acquisitionEnCours && (maintenant - dernierEchantillonMoyenne >= 150)) {
    dernierEchantillonMoyenne = maintenant;
    int mesureBpm = (bpmAffiche > 0) ? bpmAffiche : 70;
    sommeBpm += mesureBpm;
    compteurEchantillons++;

    if (compteurEchantillons >= 10) {
      uint8_t bpmMoyen = (uint8_t)(sommeBpm / 10);
      acquisitionEnCours = false;
      sauvegarderMesure(bpmMoyen, Rtc.GetDateTime());
      indexHistorique = nbMesuresStockees - 1;
    }
  }

  // 7. Rafraîchissement Écran 1 (Heure / Pouls / Menu)
  unsigned long intervalleEcran1 = (boutonEstEnfonce || acquisitionEnCours) ? 100 : 1000;
  if (maintenant - dernierAffichageHeure >= intervalleEcran1) {
    dernierAffichageHeure = maintenant;
    RtcDateTime dtRTC = Rtc.GetDateTime();
    snprintf(strHeure, sizeof(strHeure), "%02d:%02d:%02d", dtRTC.Hour(), dtRTC.Minute(), dtRTC.Second());
    dessinerEcran1();
  }

  // 8. Rafraîchissement Écran 2 (Oscilloscope PPG) avec copie miroir
  if (maintenant - dernierAffichagePPG >= 60) {
    dernierAffichagePPG = maintenant;

    // Fige le tampon interne dans l'ordre chronologique sans bloquer le Timer
    cli();
    byte head = indexTraceInterne;
    for (byte i = 0; i < LARGEUR_TRACE; i++) {
      bufferPPG_Affiche[i] = bufferPPG_Interne[(head + i) % LARGEUR_TRACE];
    }
    sei();

    dessinerEcran2();
  }
}

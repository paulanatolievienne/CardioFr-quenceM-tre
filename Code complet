#include <Arduino.h>
#include <EEPROM.h>
#include <U8g2lib.h>
#include <ThreeWire.h>
#include <RtcDS1302.h>

// =============================================================================
// 1. CONFIGURATION MATÉRIELLE DES BROCHES
// =============================================================================
// FS1 : Capteur analogique PPG
const byte PIN_PPG = A0;

// FS2 : Horloge RTC DS1302 (D2=RST/CE, D3=DAT/IO, D4=CLK/SCLK)
const int RST_PIN = 2;
const int DAT_PIN = 3;
const int CLK_PIN = 4;
ThreeWire monFil(DAT_PIN, CLK_PIN, RST_PIN);
RtcDS1302<ThreeWire> Rtc(monFil);

// FS3 : LED RGB (Cathode commune reliée à la masse GND)
const byte PIN_LED_BLEU  = 6; // D6
const byte PIN_LED_VERT  = 7; // D7
const byte PIN_LED_ROUGE = 8; // D8

// FS4 : Buzzer piézoélectrique et bouton poussoir Mute/Unmute
const byte PIN_BUZZER      = 5; // D5
const byte PIN_BOUTON_MUTE = 9; // D9 (câblé vers GND avec PULLUP)

// FS5 & FS6 : Encodeur rotatif EC11
const byte PIN_ENC_A  = 10; // D10 (PB2 / PCINT2)
const byte PIN_ENC_B  = 12; // D12 (PB4 / PCINT4)
const byte PIN_ENC_SW = 11; // D11 (Axe poussoir vers GND)

// FS5 : Double afficheur OLED SSD1306 (Software I2C)
U8G2_SSD1306_128X64_NONAME_1_SW_I2C ecran1(U8G2_R0, /* clock=*/ A4, /* data=*/ A3, /* reset=*/ U8X8_PIN_NONE);
U8G2_SSD1306_128X64_NONAME_1_SW_I2C ecran2(U8G2_R0, /* clock=*/ A2, /* data=*/ A1, /* reset=*/ U8X8_PIN_NONE);

// =============================================================================
// 2. STRUCTURE ET GESTION EEPROM (FS6)
// =============================================================================
#define ADRESSE_MAGIC       0    
#define ADRESSE_NB_MESURES  2    
#define ADRESSE_LANGUE      3    
#define ADRESSE_DEBUT_DATA  4    
#define MAX_MESURES         10
const uint16_t EEPROM_MAGIC = 0xCAFE;

struct MesureEEPROM {
  uint8_t bpm;
  uint8_t jour;
  uint8_t mois;
  uint8_t annee; // offset année 2000
  uint8_t heure;
  uint8_t minute;
  uint8_t seconde;
};

enum Langue { FR = 0, EN = 1 };
Langue langueActive = FR;

enum ModeEcran { MODE_NORMAL, MODE_HISTORIQUE, MODE_OPTIONS };
ModeEcran modeActuel = MODE_NORMAL;

int indexHistorique = 0;
uint8_t nbMesuresStockees = 0;
byte optionSelectionnee = 0; // 0 = Langue, 1 = Effacer

// Variables pour le calcul de moyenne sur 10 points (ET6.2)
bool acquisitionEnCours = false;
uint8_t compteurEchantillons = 0;
uint16_t sommeBpm = 0;
unsigned long dernierEchantillonMoyenne = 0;

// Détection appui court / long sur l'axe encodeur (D11)
const unsigned long SEUIL_APPUI_COURT_MS = 1500;
const unsigned long SEUIL_APPUI_LONG_MS  = 5000;
bool boutonEstEnfonce = false;
unsigned long tempsDebutEnfonce = 0;
unsigned long dureeAppuiCourante = 0;

// =============================================================================
// 3. VARIABLES DU TRAITEMENT PPG (TIMER1 & DOUBLE BUFFERING)
// =============================================================================
volatile int ppgBrut = 0;
volatile float ppgLisse = 500.0f;
volatile float ppgBase = 500.0f;
volatile float ppgCrete = 30.0f;

volatile bool doigtPresentVolatile = false;
volatile int bpmCalculeVolatile = 0;
volatile bool nouveauBattement = false;

// Double buffer pour supprimer les collisions mémoire et l'effet de vermicelles
const byte LARGEUR_TRACE = 88;
const byte HAUTEUR_TRACE = 36;
const byte Y_BASE = 54;
volatile uint8_t bufferPPG_Interne[LARGEUR_TRACE];
volatile byte indexTraceInterne = 0;

uint8_t bufferPPG_Affiche[LARGEUR_TRACE]; // Tampon figé pour le dessin

// Décimation temporelle pour les 3 échelles de l'oscilloscope
const uint8_t NB_ECHELLES = 3;
const unsigned int ECHELLES_DIVISEUR[NB_ECHELLES] = {1, 2, 4}; // 10ms, 20ms, 40ms
const char NOMS_ECHELLES[3][8] = {"10ms", "25ms", "50ms"};
volatile int8_t indexEchelle = 1;

// Variables miroir pour la boucle loop
int bpmAffiche = 0;
bool doigtPresent = false;

unsigned long dernierAffichagePPG = 0;
unsigned long dernierAffichageHeure = 0;
char strHeure[9] = "00:00:00";

// FS4 : Paramètres audio
const unsigned int FREQ_GRAVE   = 440;
const unsigned int FREQ_MODEREE = 880;
const unsigned int FREQ_AIGUE   = 1760;
bool sonActive = true;
bool dernierEtatMute = HIGH;
unsigned long dernierDebounceMute = 0;

// Encodeur
volatile int deltaEncodeur = 0;
volatile unsigned long dernierTempsInterruption = 0;

// =============================================================================
// 4. ROUTINES D'INTERRUPTION MATÉRIELLE
// =============================================================================
// Interruption PCINT sur l'encodeur rotatif (D10 / D12)
ISR(PCINT0_vect) {
  uint8_t etatA = (PINB & (1 << PINB2)) ? HIGH : LOW;
  uint8_t etatB = (PINB & (1 << PINB4)) ? HIGH : LOW;

  unsigned long maintenant = millis();
  if (etatA == LOW && (maintenant - dernierTempsInterruption > 35)) {
    dernierTempsInterruption = maintenant;
    if (etatB == HIGH) {
      deltaEncodeur++;
      if (modeActuel == MODE_NORMAL && indexEchelle < NB_ECHELLES - 1) indexEchelle++;
    } else {
      deltaEncodeur--;
      if (modeActuel == MODE_NORMAL && indexEchelle > 0) indexEchelle--;
    }
  }
}

// Routine d'interruption Timer 1 : Échantillonnage PPG cadencé rigoureusement à 100 Hz (10 ms)
ISR(TIMER1_COMPA_vect) {
  static unsigned int compteurEchelle = 0;
  static unsigned long tempsDernierPic = 0;
  static bool enPicInterne = false;
  static unsigned long tempsMsInterne = 0;
  tempsMsInterne += 10;

  int brut = analogRead(PIN_PPG);
  ppgBrut = brut;

  // Détection nette de la présence du doigt
  if (brut < 200 || brut > 980) {
    doigtPresentVolatile = false;
    bpmCalculeVolatile = 0;
    enPicInterne = false;
    ppgLisse = brut;
    ppgBase = brut;
    return;
  }

  doigtPresentVolatile = true;

  // Filtrage passe-bas et suivi de la ligne de base (DC)
  ppgLisse += 0.20f * (brut - ppgLisse);
  ppgBase  += 0.015f * (ppgLisse - ppgBase);
  float ac = ppgLisse - ppgBase;

  // Suivi dynamique de l'amplitude crête
  if (abs(ac) > ppgCrete) {
    ppgCrete = abs(ac);
  } else {
    ppgCrete *= 0.994f;
    if (ppgCrete < 15.0f) ppgCrete = 15.0f;
  }

  // Normalisation centrée de l'onde
  float n = 0.5f + (ac / (2.0f * ppgCrete));
  if (n > 1.0f) n = 1.0f;
  if (n < 0.0f) n = 0.0f;

  // Écriture continue dans le tampon interne
  compteurEchelle++;
  if (compteurEchelle >= ECHELLES_DIVISEUR[indexEchelle]) {
    compteurEchelle = 0;
    bufferPPG_Interne[indexTraceInterne] = (uint8_t)(n * 34.0f);
    indexTraceInterne = (indexTraceInterne + 1) % LARGEUR_TRACE;
  }

  // Trigger de Schmitt avec période réfractaire de 480 ms pour bloquer l'onde dicrote
  if (!enPicInterne) {
    if (n > 0.65f && (tempsMsInterne - tempsDernierPic > 480)) {
      enPicInterne = true;
      unsigned long dt = tempsMsInterne - tempsDernierPic;
      tempsDernierPic = tempsMsInterne;

      if (dt >= 480 && dt <= 1600) {
        int bpmInst = 60000UL / dt;
        if (bpmCalculeVolatile == 0) {
          bpmCalculeVolatile = bpmInst;
        } else {
          // Lissage pondéré
          bpmCalculeVolatile = (bpmCalculeVolatile * 3 + bpmInst) / 4;
        }
        nouveauBattement = true;
      }
    }
  } else {
    if (n < 0.35f) {
      enPicInterne = false; // Réarmement
    }
  }
}

// =============================================================================
// 5. FONCTIONS EEPROM
// =============================================================================
void initialiserEEPROM() {
  uint16_t magic;
  EEPROM.get(ADRESSE_MAGIC, magic);
  if (magic != EEPROM_MAGIC) {
    EEPROM.put(ADRESSE_MAGIC, EEPROM_MAGIC);
    nbMesuresStockees = 0;
    EEPROM.write(ADRESSE_NB_MESURES, 0);
    langueActive = FR;
    EEPROM.write(ADRESSE_LANGUE, (uint8_t)FR);
  } else {
    nbMesuresStockees = EEPROM.read(ADRESSE_NB_MESURES);
    if (nbMesuresStockees > MAX_MESURES) nbMesuresStockees = 0;
    langueActive = (Langue)EEPROM.read(ADRESSE_LANGUE);
    if (langueActive > EN) langueActive = FR;
  }
}

void effacerHistoriqueEEPROM() {
  nbMesuresStockees = 0;
  EEPROM.write(ADRESSE_NB_MESURES, 0);
  indexHistorique = 0;
}

void sauvegarderMesure(uint8_t bpmMoyen, RtcDateTime dt) {
  MesureEEPROM m;
  m.bpm = bpmMoyen;
  m.jour = dt.Day();
  m.mois = dt.Month();
  m.annee = (uint8_t)(dt.Year() - 2000);
  m.heure = dt.Hour();
  m.minute = dt.Minute();
  m.seconde = dt.Second();

  if (nbMesuresStockees >= MAX_MESURES) {
    for (int i = 0; i < MAX_MESURES - 1; i++) {
      MesureEEPROM temp;
      EEPROM.get(ADRESSE_DEBUT_DATA + (i + 1) * sizeof(MesureEEPROM), temp);
      EEPROM.put(ADRESSE_DEBUT_DATA + i * sizeof(MesureEEPROM), temp);
    }
    nbMesuresStockees = MAX_MESURES - 1;
  }

  int adresse = ADRESSE_DEBUT_DATA + nbMesuresStockees * sizeof(MesureEEPROM);
  EEPROM.put(adresse, m);
  nbMesuresStockees++;
  EEPROM.write(ADRESSE_NB_MESURES, nbMesuresStockees);
}

MesureEEPROM lireMesure(uint8_t index) {
  MesureEEPROM m;
  int adresse = ADRESSE_DEBUT_DATA + index * sizeof(MesureEEPROM);
  EEPROM.get(adresse, m);
  return m;
}

// =============================================================================
// 6. ACTIONNEURS : LED RGB ET BUZZER
// =============================================================================
void actualiserActionneurs() {
  if (!doigtPresent || bpmAffiche < 35 || bpmAffiche > 220) {
    digitalWrite(PIN_LED_ROUGE, LOW);
    digitalWrite(PIN_LED_VERT, LOW);
    digitalWrite(PIN_LED_BLEU, LOW);
    return;
  }

  if (bpmAffiche < 60) {
    // Bradycardie : Jaune (Rouge + Vert haché)
    digitalWrite(PIN_LED_BLEU, LOW);
    digitalWrite(PIN_LED_ROUGE, HIGH);
    static byte cpt = 0;
    cpt = (cpt + 1) % 4;
    digitalWrite(PIN_LED_VERT, (cpt == 0) ? HIGH : LOW);
  } else if (bpmAffiche <= 100) {
    // Normocardie : Vert
    digitalWrite(PIN_LED_ROUGE, LOW);
    digitalWrite(PIN_LED_VERT, HIGH);
    digitalWrite(PIN_LED_BLEU, LOW);
  } else {
    // Tachycardie : Rouge
    digitalWrite(PIN_LED_ROUGE, HIGH);
    digitalWrite(PIN_LED_VERT, LOW);
    digitalWrite(PIN_LED_BLEU, LOW);
  }
}

void declencherBip() {
  if (!sonActive || !doigtPresent || bpmAffiche < 35 || bpmAffiche > 220) return;

  unsigned int freq = FREQ_MODEREE;
  if (bpmAffiche < 60) freq = FREQ_GRAVE;
  else if (bpmAffiche > 100) freq = FREQ_AIGUE;

  tone(PIN_BUZZER, freq, 35);
}

